#!/usr/bin/make -f

DH_VERBOSE = 1
export DH_OPTIONS=-v
export DEB_BUILD_OPTIONS=nocheck
LSB_SI=$(shell lsb_release -si)
LSB_SR=$(shell lsb_release -sr)

ifeq ($(LSB_SI),Ubuntu)
    ifeq ($(LSB_SR),22.04)
        DEPS=python2.7
    endif
endif

%:
	dh $@

override_dh_auto_configure:
	@echo "Skipping configure"

override_dh_auto_clean:
	@echo "Skipping clean"

override_dh_auto_build:
	@echo Building with GPROOT=$(GPROOT), GPDIR=$(GPDIR)"
	$(MAKE) dist GPROOT="$(GPROOT)" GPDIR="$(GPDIR)"

override_dh_auto_install:
	@echo Files already in place"

override_dh_gencontrol:
	dh_gencontrol -pgpdb -- -VpythonRequires="$(DEPS)"
