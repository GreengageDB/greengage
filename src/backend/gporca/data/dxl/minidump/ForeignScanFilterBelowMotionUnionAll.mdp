<?xml version="1.0" encoding="UTF-8"?>
<dxl:DXLMessage xmlns:dxl="http://greengagedb.org/dxl/2010/12/">
<dxl:Comment><![CDATA[
	Objective: A filter on a coordinator-only foreign table under UNION ALL is
	evaluated before the motion that moves the rows to the segments. The union
	requires a non-singleton distribution from the foreign branch. The first
	distribution request of CPhysicalFilter passes that requirement to its child,
	which puts the Redistribute Motion below the filter: every row of the foreign
	table is moved. The second request lets the child keep its singleton
	distribution and enforces the motion on the filter's output, so the cost model
	can choose between the two. Here the filter below the motion is cheaper, and
	the motion's row estimate reflects the filter's selectivity (400000 of 1000000
	rows, the default selectivity for a table without statistics).

	create table heap (a int, b int, c text) distributed by (a);
	insert into heap select i, i, 'row' || i from generate_series(1, 10000) i;
	analyze heap;
	create external web table ext (a int, b int, c text)
	    execute 'seq 1 100000 | awk ''{print $1","$1",row"$1}''' on coordinator format 'csv';

	explain select * from (select a, b, c from heap union all select a, b, c from ext) u where a = 5;

	 Gather Motion 3:1  (slice1; segments: 3)  (cost=0.00..974.90 rows=400001 width=16)
	   ->  Append  (cost=0.00..951.05 rows=133334 width=16)
	         ->  Seq Scan on heap  (cost=0.00..431.19 rows=1 width=15)
	               Filter: (a = 5)
	         ->  Redistribute Motion 1:3  (slice2)  (cost=0.00..517.72 rows=133334 width=16)
	               ->  Foreign Scan on ext  (cost=0.00..501.10 rows=400000 width=16)
	                     Filter: (a = 5)
	 Optimizer: GPORCA
]]>
</dxl:Comment>
