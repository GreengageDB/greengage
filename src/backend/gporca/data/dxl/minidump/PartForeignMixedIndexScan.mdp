<?xml version="1.0" encoding="UTF-8"?>
<dxl:DXLMessage xmlns:dxl="http://greengagedb.org/dxl/2010/12/">
<dxl:Comment><![CDATA[
Objective: A dynamic index scan built on the heap branch of a partitioned table
with a foreign partition lists every partition of the table and selects its
own partitions with SelectedPartitionSet, the same way the dynamic table scan
and the dynamic foreign scan do.

CREATE TABLE part_mixed (a int, b int) PARTITION BY RANGE (b);
CREATE EXTERNAL TABLE p_e1 (a int, b int) LOCATION ('file://host/tmp/part1.csv') FORMAT 'csv';
ALTER TABLE part_mixed ATTACH PARTITION p_e1 FOR VALUES FROM (0) TO (10);
CREATE TABLE p_1 (a int, b int) DISTRIBUTED BY (a);
INSERT INTO p_1 values (15, 15);
ALTER TABLE part_mixed ATTACH PARTITION p_1 FOR VALUES FROM (10) TO (20);
CREATE TABLE p_2 (a int, b int) DISTRIBUTED BY (a);
ALTER TABLE part_mixed ATTACH PARTITION p_2 FOR VALUES FROM (20) TO (30);
analyse part_mixed;
create table filter_table (a int) distributed by (a);
insert into filter_table values (15);
create index on part_mixed(a);
set optimizer_enable_dynamictablescan = off;

explain select pm.a, pm.b from part_mixed pm join filter_table ft on pm.b = ft.a and pm.a = 15;

 Hash Join  (cost=0.00..885.93 rows=1 width=8)
   Hash Cond: (ft.a = pm.b)
   ->  Gather Motion 3:1  (slice1; segments: 3)  (cost=0.00..431.00 rows=1 width=4)
         ->  Seq Scan on filter_table ft  (cost=0.00..431.00 rows=1 width=4)
   ->  Hash  (cost=454.93..454.93 rows=1 width=8)
         ->  Gather Motion 3:1  (slice2; segments: 3)  (cost=0.00..454.93 rows=1 width=8)
               ->  Append  (cost=0.00..454.93 rows=1 width=8)
                     ->  Dynamic Index Scan on part_mixed_a_idx on part_mixed pm  (cost=0.00..6.00 rows=1 width=8)
                           Index Cond: (a = 15)
                           Number of partitions to scan: 2 (out of 3)
                     ->  Dynamic Foreign Scan on part_mixed pm  (cost=0.00..448.93 rows=1 width=8)
                           Filter: (a = 15)
                           Number of partitions to scan: 1 (out of 3)
 Optimizer: GPORCA
(14 rows)
]]>
</dxl:Comment>
