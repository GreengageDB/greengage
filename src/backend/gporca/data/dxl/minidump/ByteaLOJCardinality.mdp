<?xml version="1.0" encoding="UTF-8"?>
<dxl:DXLMessage xmlns:dxl="http://greengagedb.org/dxl/2010/12/">
  <dxl:Comment><![CDATA[
      CREATE TABLE orca_probe_a AS
      SELECT
          decode(lpad(to_hex(i), 40, '0'), 'hex') AS key_bytea,
          lpad(to_hex(i), 40, '0') AS key_text
      FROM generate_series(1, 10000) AS g(i)
      DISTRIBUTED RANDOMLY;

      CREATE TABLE orca_probe_b AS
      SELECT * FROM orca_probe_a DISTRIBUTED RANDOMLY;

      ANALYZE orca_probe_a;
      ANALYZE orca_probe_b;

      EXPLAIN
      SELECT a.key_bytea, b.key_bytea
      FROM orca_probe_a a
      LEFT JOIN orca_probe_b b ON a.key_bytea = b.key_bytea;
                                                            QUERY PLAN                                                
      ----------------------------------------------------------------------------------------------------------
       Gather Motion 3:1  (slice3; segments: 3)  (cost=0.00..870.02 rows=20000 width=42)
         ->  Hash Left Join  (cost=0.00..866.89 rows=6667 width=42)
               Hash Cond: (a.key_bytea = b.key_bytea)
               ->  Redistribute Motion 3:3  (slice1; segments: 3)  (cost=0.00..431.52 rows=3334 width=21)
                     Hash Key: a.key_bytea
                     ->  Seq Scan on orca_probe_a a  (cost=0.00..431.17 rows=3334 width=21)
               ->  Hash  (cost=431.52..431.52 rows=3334 width=21)
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)  (cost=0.00..431.52 rows=3334 width=21)
                           Hash Key: b.key_bytea
                           ->  Seq Scan on orca_probe_b b  (cost=0.00..431.17 rows=3334 width=21)
       Optimizer: Pivotal Optimizer (GPORCA)
      (11 rows)
    ]]>
  </dxl:Comment>
