<?xml version="1.0" encoding="UTF-8"?>
<dxl:DXLMessage xmlns:dxl="http://greengagedb.org/dxl/2010/12/">
<dxl:Comment><![CDATA[
	Objective: Select over the union all that CXformExpandDynamicGetWithForeignPartitions
	creates for a partitioned table with a coordinator-executed foreign partition.
	CXformSelectOverUnionAll2UnionAllOverSelect adds the alternative with the filter
	pushed into both branches (plan space size 2 -> 4). Without an index on the heap
	partitions the pushed alternative is costed higher, because the foreign branch is
	estimated with the row count of the whole table, so the chosen plan keeps the
	filter above the Append.

	create table part (a int, b int) distributed by (a) partition by range (b)
	    (start (0) end (30) every (10));
	insert into part select i, i % 20 from generate_series(1, 10000) i;
	analyze part;
	create external web table p3_e (a int, b int)
	    execute 'seq 1 100 | awk ''{print $1","20+($1%10)}''' on coordinator format 'csv';
	alter table part exchange partition for (25) with table p3_e;

	explain select * from part where a = 5;

	 Gather Motion 3:1  (slice1; segments: 3)  (cost=0.00..919.37 rows=1 width=8)
	   ->  Result  (cost=0.00..919.37 rows=1 width=8)
	         Filter: (part.a = 5)
	         ->  Append  (cost=0.00..919.26 rows=3334 width=8)
	               ->  Dynamic Seq Scan on part  (cost=0.00..431.07 rows=3334 width=8)
	                     Number of partitions to scan: 2 (out of 3)
	               ->  Redistribute Motion 1:3  (slice2)  (cost=0.00..488.12 rows=336667 width=8)
	                     ->  Dynamic Foreign Scan on part  (cost=0.00..452.11 rows=1010000 width=8)
	                           Number of partitions to scan: 1 (out of 3)
	 Optimizer: GPORCA
]]>
</dxl:Comment>
