<?xml version="1.0" encoding="UTF-8"?>
<dxl:DXLMessage xmlns:dxl="http://greengagedb.org/dxl/2010/12/">
<dxl:Comment><![CDATA[
Objective: Dynamic bitmap heap scan built on the heap branch of a partitioned
table whose foreign partitions sit in the middle of the partition list. The
scan keeps the full partition list and selects the heap partitions with
SelectedPartitionSet, which is not a single range of positions here.

CREATE TABLE part_mixed (a int, b int) PARTITION BY RANGE (b);
CREATE TABLE p_0 (a int, b int) DISTRIBUTED BY (a);
INSERT INTO p_0 values (-5, -5);
ALTER TABLE part_mixed ATTACH PARTITION p_0 FOR VALUES FROM (-10) TO (0);
CREATE EXTERNAL TABLE p_e1 (a int, b int) LOCATION ('file://host/tmp/part1.csv') FORMAT 'csv';
ALTER TABLE part_mixed ATTACH PARTITION p_e1 FOR VALUES FROM (0) TO (10);
CREATE EXTERNAL TABLE p_e2 (a int, b int) LOCATION ('file://host/tmp/part2.csv') FORMAT 'csv';
ALTER TABLE part_mixed ATTACH PARTITION p_e2 FOR VALUES FROM (10) TO (20);
CREATE TABLE p_3 (a int, b int) DISTRIBUTED BY (a);
INSERT INTO p_3 values (35, 35);
ALTER TABLE part_mixed ATTACH PARTITION p_3 FOR VALUES FROM (30) TO (40);
analyse part_mixed;
create index on part_mixed(a);
set optimizer_enable_dynamictablescan = off;
set optimizer_enable_dynamicindexscan = off;
set optimizer_enable_dynamicindexonlyscan = off;

explain (costs off) select * from part_mixed pm where pm.a = 35 or pm.a = -5;

 Gather Motion 3:1  (slice1; segments: 3)
   ->  Append
         ->  Dynamic Bitmap Heap Scan on part_mixed pm
               Number of partitions to scan: 2 (out of 4)
               Recheck Cond: ((a = 35) OR (a = '-5'::integer))
               Filter: ((a = 35) OR (a = '-5'::integer))
               ->  BitmapOr
                     ->  Dynamic Bitmap Index Scan on part_mixed_a_idx
                           Index Cond: (a = 35)
                     ->  Dynamic Bitmap Index Scan on part_mixed_a_idx
                           Index Cond: (a = '-5'::integer)
         ->  Dynamic Foreign Scan on part_mixed pm
               Filter: ((a = 35) OR (a = '-5'::integer))
               Number of partitions to scan: 2 (out of 4)
 Optimizer: GPORCA
(15 rows)
]]>
</dxl:Comment>
