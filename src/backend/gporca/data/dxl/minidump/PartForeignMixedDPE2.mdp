<?xml version="1.0" encoding="UTF-8"?>
<dxl:DXLMessage
        xmlns:dxl="http://greengagedb.org/dxl/2010/12/">
<dxl:Comment><![CDATA[
All Dynamic Scans must have the same number of partitions, as in the Partition
Selector.
CREATE FOREIGN TABLE test_fdw (
        id bigint,
        created timestamp, val text
)
  SERVER foreign_server
  OPTIONS (schema_name 'public', table_name 'test', mpp_execute 'all segments');
  
INSERT INTO test_fdw --
  WITH gen AS (SELECT generate_series(1,1000) AS id)
  SELECT id,'2020-01-01'::timestamp + make_interval(secs => id), CONCAT(md5(random()::TEXT),id::TEXT) AS value_string FROM gen;
CREATE TABLE test_part_cold (id BIGINT,created TIMESTAMP, val TEXT)
        WITH (APPENDOPTIMIZED=TRUE
                ,ORIENTATION = COLUMN
                ,COMPRESSTYPE = ZSTD
                ,COMPRESSLEVEL = 3)
        DISTRIBUTED BY (id)
        PARTITION BY RANGE (created)
        (START (date '2020-01-01') INCLUSIVE
           END (date '2021-01-01') EXCLUSIVE
           EVERY (INTERVAL '1 month'));
INSERT INTO test_part_cold --
        WITH gen AS (SELECT generate_series(1,1000) AS id)
        SELECT id,'2020-02-01'::timestamp + make_interval(secs => id), CONCAT(md5(random()::TEXT),id::TEXT) AS value_string FROM gen;
CREATE TABLE test_filter (filter TIMESTAMP) DISTRIBUTED BY (filter);
INSERT INTO test_filter VALUES (TIMESTAMP '2020-02-01 00:00:01');

ALTER TABLE test_part_cold DETACH PARTITION test_part_cold_1_prt_1;
ALTER TABLE test_part_cold ATTACH PARTITION test_s3_fdw FOR VALUES FROM (DATE '2020-01-01') TO (DATE '2020-02-01');

SELECT * FROM test_part_cold WHERE created=TIMESTAMP '2020-02-01 00:00:01';
  ]]>
</dxl:Comment>
