<?xml version="1.0" encoding="UTF-8"?>
<dxl:DXLMessage xmlns:dxl="http://greengagedb.org/dxl/2010/12/">
  <dxl:Comment><![CDATA[
create table t_left (id1 int, val1 int);
create table t_right(id2 int, val2 int);

insert into t_left  select (i % 100), 100+i  from generate_series(1, 100) i;
insert into t_right select (i % 100), 1000+i from generate_series(1, 1000) i;

analyze t_left, t_right;

explain verbose
select * from
t_left l left join t_right r
on l.id1 = r.id2
and r.val2 - 1000 - (r.val2 % 2) = (l.val1 - 100)
where r.id2 is NULL;
  ]]></dxl:Comment>
