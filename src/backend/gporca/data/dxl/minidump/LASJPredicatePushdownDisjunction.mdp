<?xml version="1.0" encoding="UTF-8"?>
<dxl:DXLMessage xmlns:dxl="http://greengagedb.org/dxl/2010/12/">
  <dxl:Comment><![CDATA[
	Objective: LASJ cardinality must not collapse when a single-table
	ON-clause predicate that gets pushed down to a pre-join filter is a
	disjunction with a modulo branch, not just a plain modulo expression
	by itself.

	create table t_left (id1 int, val1 int);
	create table t_right(id2 int, val2 int);

	insert into t_left select i, i from generate_series(1, 100)i;
	insert into t_right select i, i from generate_series(1, 100)i;

	analyze t_left, t_right;

	select * from
	t_left l left join t_right r
	on l.id1 = r.id2
	and (r.id2 % 2 = 1 or r.val2 = -1)
	where r.id2 is NULL;

	-- val2 = -1 can never match (val2 only ever holds 1..100), so this is
	-- the same 50/100-row split as the plain "r.id2 % 2 = 1" case, just
	-- with the modulo condition wrapped in an otherwise-inert OR.
  ]]>
  </dxl:Comment>
