-- @Description Ensures that aoseg statistics are correctly repaired if
-- there is an inconsistency between master and segments.
--
CREATE TABLE vacuum_aoseg_repair_@orientation@ (a INT, b INT) WITH (appendonly=true, orientation=@orientation@);
CREATE
1: BEGIN;
BEGIN
2: BEGIN;
BEGIN
3: BEGIN;
BEGIN
1: INSERT INTO vacuum_aoseg_repair_@orientation@ SELECT i as a, i as b FROM generate_series(1, 10000) AS i;
INSERT 10000
-- Don't actually insert anything into segment file 2, just allocate it.
-- We need this to reproduce a situation that VACUUM couldn't fix before:
-- after creating three segments and breaking statistics for the 3rd, vacuum will
-- allocate a new segment for insertion, choosing the first empty one.
-- If all segments have data, 3rd segment will be chosen (due to broken stats)
-- and the stats will be updated. So we need 2nd segment to be empty, to make
-- vacuum choose 2nd segment for insertion and ignore the 3rd segment completely.
2: INSERT INTO vacuum_aoseg_repair_@orientation@ SELECT 1 as a, 1 as b LIMIT 0;
INSERT 0
3: INSERT INTO vacuum_aoseg_repair_@orientation@ SELECT i as a, i as b FROM generate_series(1, 10000) AS i;
INSERT 10000
1: COMMIT;
COMMIT
2: COMMIT;
COMMIT
3: COMMIT;
COMMIT
DELETE FROM vacuum_aoseg_repair_@orientation@ WHERE a <= 9000;
DELETE 18000

-- Check current statistics
SELECT segno, tupcount FROM gp_ao_or_aocs_seg('vacuum_aoseg_repair_@orientation@'::regclass);
 segno | tupcount 
-------+----------
 1     | 10000    
 3     | 10000    
(2 rows)

-- Corrupt statistics on master
-- We have to use dynamic SQL because we don't know table's OID in advance
DO $$declare table_oid oid;	/* in func */ relstorage_var char;	/* in func */ aoseg_name text;	/* in func */ begin select 'vacuum_aoseg_repair_@orientation@'::regclass::oid into table_oid;	/* in func */ select relstorage into relstorage_var from pg_class where oid = table_oid;	/* in func */ if relstorage_var = 'c' then select 'pg_aoseg.pg_aocsseg_' || table_oid into aoseg_name;	/* in func */ else select 'pg_aoseg.pg_aoseg_' || table_oid into aoseg_name;	/* in func */ end if;	/* in func */ 
set local allow_system_table_mods = on;	/* in func */ execute 'UPDATE ' || aoseg_name || ' SET tupcount = 0 WHERE segno = 3';	/* in func */ set local allow_system_table_mods = off;	/* in func */ end$$;
DO

SELECT segno, tupcount FROM gp_ao_or_aocs_seg('vacuum_aoseg_repair_@orientation@'::regclass);
 segno | tupcount 
-------+----------
 1     | 10000    
 3     | 0        
(2 rows)

-- Make sure hash table is updated with corrupted statistics
SELECT gp_toolkit.__gp_remove_ao_entry_from_cache('vacuum_aoseg_repair_@orientation@'::regclass);
 __gp_remove_ao_entry_from_cache 
---------------------------------
                                 
(1 row)

-- This VACUUM should fix it
SET gp_appendonly_vacuum_update_stats = true;
SET
VACUUM vacuum_aoseg_repair_@orientation@;
VACUUM
RESET gp_appendonly_vacuum_update_stats;
RESET

-- Check statistics
-- In both the aoseg table and the cache, we expect to see two segment files with 1000 tuples each.
-- No segments with 10000 tuples or more should be left unvacuumed.
-- Segment files with 0 tuples are also acceptable.
SELECT segno, tupcount, state FROM gp_ao_or_aocs_seg('vacuum_aoseg_repair_@orientation@'::regclass);
 segno | tupcount 
-------+----------
 1     | 0        
 2     | 1000     
 3     | 0        
 4     | 1000     
(4 rows)
SELECT segno, total_tupcount FROM gp_toolkit.__gp_get_ao_entry_from_cache('vacuum_aoseg_repair_@orientation@'::regclass) WHERE total_tupcount > 0;
 segno | total_tupcount 
-------+----------------
 2     | 1000           
 4     | 1000           
(2 rows)
