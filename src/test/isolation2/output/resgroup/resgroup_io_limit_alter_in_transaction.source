-- Remove the tablespace dependency before the tablespaces are dropped.
ALTER RESOURCE GROUP rg_alter_tran SET io_limit '-1';
ALTER RESOURCE GROUP
DROP TABLESPACE rg_io_limit_ts_1;
DROP TABLESPACE
DROP TABLESPACE rg_io_limit_ts_2;
DROP TABLESPACE
select rmdir('@testtablespace@/rg_io_limit_ts_1') from gp_dist_random('gp_id') intersect select rmdir('@testtablespace@/rg_io_limit_ts_1') from gp_id;
