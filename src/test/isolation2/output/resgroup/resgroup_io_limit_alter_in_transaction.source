ALTER RESOURCE GROUP
ALTER RESOURCE GROUP rg_alter_tran SET io_limit 'rg_io_limit_ts_2:rbps=2000,wbps=2000;rg_io_limit_ts_1:rbps=1000,wbps=1000';
ALTER RESOURCE GROUP
COMMIT;
COMMIT

