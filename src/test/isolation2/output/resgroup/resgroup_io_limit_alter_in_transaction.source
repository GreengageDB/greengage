-- 6 ALTER changes io_limit and then changes it back in one transaction.
-- The stored value compare keeps the callback whose value matches the final
-- catalog state, so the committed value is the prior one.
BEGIN;
BEGIN
ALTER RESOURCE GROUP rg_alter_tran SET io_limit 'pg_default:rbps=6000,wbps=6000';
ALTER RESOURCE GROUP
ALTER RESOURCE GROUP rg_alter_tran SET io_limit 'pg_default:rbps=5000,wbps=5000';
ALTER RESOURCE GROUP
COMMIT;
COMMIT

SELECT * FROM rg_alter_tran_status_io_limit;
 groupname       | io_limit
-----------------+----------------------------------------------
 rg_alter_tran   | 1663:rbps=5000,wbps=5000,riops=max,wiops=max
 rg_alter_tran_b | 1663:rbps=2000,wbps=2000,riops=max,wiops=max
(2 rows)

SELECT check_cgroup_io_max('rg_alter_tran', 'pg_default', 'rbps=5242880000 wbps=5242880000 riops=max wiops=max');
 check_cgroup_io_max
---------------------
 t
(1 row)

-- 7 Two ALTERs set the same io_limit across two tablespaces in a different
-- element order. The order-independent compare treats the two values as equal,
-- so the duplicate is dropped and only one apply happens.
select mkdir('@testtablespace@/rg_io_limit_ts_1') from gp_dist_random('gp_id') intersect select mkdir('@testtablespace@/rg_io_limit_ts_1') from gp_id;
 mkdir
-------
 t
(1 row)

select mkdir('@testtablespace@/rg_io_limit_ts_2') from gp_dist_random('gp_id') intersect select mkdir('@testtablespace@/rg_io_limit_ts_2') from gp_id;
 mkdir
-------
 t
(1 row)

CREATE TABLESPACE rg_io_limit_ts_1 LOCATION '@testtablespace@/rg_io_limit_ts_1';
CREATE TABLESPACE
CREATE TABLESPACE rg_io_limit_ts_2 LOCATION '@testtablespace@/rg_io_limit_ts_2';
CREATE TABLESPACE
