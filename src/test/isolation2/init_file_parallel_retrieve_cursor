-- start_matchsubs

m/^ERROR: .* (seg\d+ [0-9.]+:\d+ pid=\d+)/
s/seg\d+ [0-9.]+:\d+ pid=\d+/SEG IP:PORT pid=PID/

# Ignore session id in fatal error message
m/for session id -?[0-9]+/
s/for session id -?[0-9]+/for session id xxx/

# skip specific PID in: ERROR:  end point token_id3 already attached by receiver(pid: 50938)
m/^ERROR:.*\(pid: \d+\)/
s/\(pid: \d+\)/\(pid: PID\)/

m/\(cdbendpointretrieve\.c\:\d+\)/
s/\(cdbendpointretrieve\.c:\d+\)/\(cdbendpointretrieve\.c:LINE_NUM\)/

# Newer libpq prefixes connection failures with "connection to server at 
# host ..., port ... failed:" even when the failure is a FATAL from the server
# during startup. Mask both fields unconditionally with wildcards (rather
# than matching the literal host_id/port_id placeholder text) since this
# static init file's rules run before the per-test dynamic host_id/port_id
# substitution, so the real hostname/IP/port is still what's on the line
# at this point. libpq also sometimes shows the resolved IP in parens
# after the hostname; that's covered by the same optional group.
m/connection to server at "[^"]*"(?: \([^)]*\))?, port \d+ failed:/
s/connection to server at "[^"]*"(?: \([^)]*\))?, port \d+ failed:/connection to server at "HOST", port PORT failed:/

-- end_matchsubs
