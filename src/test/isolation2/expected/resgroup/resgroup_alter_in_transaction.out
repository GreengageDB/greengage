-- Concurrent ALTERs

-- 18 Error during pg_resgroup_move_query when ALTER is uncommitted.
1: BEGIN;
BEGIN
1: ALTER RESOURCE GROUP rg_alter_tran_b SET CONCURRENCY 16;
ALTER
2: SELECT gp_toolkit.pg_resgroup_move_query(999999999, 'rg_alter_tran_b');
ERROR:  cannot move query while a resource group is being edited
1: ROLLBACK;
ROLLBACK
SELECT * FROM rg_alter_tran_status;
 groupname       | concurrency | cpu_rate_limit | memory_limit 
-----------------+-------------+----------------+--------------
 rg_alter_tran   | 15          | 10             | 9            
 rg_alter_tran_b | 21          | 10             | 8            
(2 rows)

-- 19 DROP RESOURCE GROUP waits while ALTER is uncommitted.
1: BEGIN;
BEGIN
1: ALTER RESOURCE GROUP rg_alter_tran_b SET CONCURRENCY 17;
ALTER
2&: DROP RESOURCE GROUP rg_alter_tran_b;  <waiting ...>
1: ROLLBACK;
ROLLBACK
2<:  <... completed>
DROP
SELECT * FROM rg_alter_tran_status;
 groupname     | concurrency | cpu_rate_limit | memory_limit 
---------------+-------------+----------------+--------------
 rg_alter_tran | 15          | 10             | 9            
(1 row)

-- 20 CREATE RESOURCE GROUP waits while ALTER is uncommitted.
1: BEGIN;
BEGIN
1: ALTER RESOURCE GROUP rg_alter_tran SET CONCURRENCY 18;
ALTER
2&: CREATE RESOURCE GROUP rg_alter_tran_b WITH (cpu_rate_limit=10, memory_limit=10, concurrency=2);  <waiting ...>
1: ROLLBACK;
ROLLBACK
2<:  <... completed>
CREATE
