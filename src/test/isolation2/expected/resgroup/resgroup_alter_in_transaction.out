BEGIN;
BEGIN
ALTER RESOURCE GROUP rg_alter_tran SET CONCURRENCY 14;
ALTER
ALTER RESOURCE GROUP rg_alter_tran SET CONCURRENCY 13;
ALTER
COMMIT;
COMMIT
