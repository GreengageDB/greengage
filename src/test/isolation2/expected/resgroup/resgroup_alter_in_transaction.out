ALTER
ALTER RESOURCE GROUP rg_alter_tran SET CONCURRENCY 15;
ALTER
SAVEPOINT s1;
SAVEPOINT
ALTER RESOURCE GROUP rg_alter_tran SET MEMORY_LIMIT 11;
ALTER
ALTER RESOURCE GROUP rg_alter_tran SET MEMORY_LIMIT 12;
ALTER
ROLLBACK TO SAVEPOINT s1;
ROLLBACK
COMMIT;
COMMIT
