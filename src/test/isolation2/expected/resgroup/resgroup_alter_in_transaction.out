-----------------+-------------+-----------------+------------+--------+--------------+----------+----------
 rg_alter_tran   | 24          | 11              | 110        | -1     | 7            | 10       | -1       
 rg_alter_tran_b | 21          | 11              | 120        | -1     | 8            | 20       | -1       
(2 rows)


-- Test subtransaction rollbacks

-- 13 Subtransaction rollback with explicit SAVEPOINT.
-- Rolled back ALTER must not be applied.
BEGIN;
BEGIN
SAVEPOINT s1;
SAVEPOINT
ALTER RESOURCE GROUP rg_alter_tran SET CONCURRENCY 10;
ALTER RESOURCE GROUP
ROLLBACK TO SAVEPOINT s1;
ROLLBACK
COMMIT;
COMMIT
SELECT * FROM rg_alter_tran_status;
 groupname       | concurrency | cpu_max_percent | cpu_weight | cpuset | memory_limit | min_cost | io_limit 
-----------------+-------------+-----------------+------------+--------+--------------+----------+----------
 rg_alter_tran   | 24          | 11              | 110        | -1     | 7            | 10       | -1       
 rg_alter_tran_b | 21          | 11              | 120        | -1     | 8            | 20       | -1       
(2 rows)

-- 14 Subtransaction rollback followed by the same final value.
-- The rolled back callback and the real callback have the same target value;
-- only one apply should matter.
SELECT gp_inject_fault('resgroup_alter_on_commit', 'reset', dbid) FROM gp_segment_configuration WHERE content = -1 AND role = 'p';
 gp_inject_fault 
-----------------
 Success:        
(1 row)

SELECT gp_inject_fault('resgroup_alter_on_commit', 'skip', '', '', '', 1, 100, 0, dbid) FROM gp_segment_configuration WHERE content = -1 AND role = 'p';
 gp_inject_fault 
-----------------
 Success:        
(1 row)

BEGIN;
BEGIN
SAVEPOINT s1;
SAVEPOINT
ALTER RESOURCE GROUP rg_alter_tran SET CONCURRENCY 11;
ALTER RESOURCE GROUP
ROLLBACK TO SAVEPOINT s1;
ROLLBACK
ALTER RESOURCE GROUP rg_alter_tran SET CONCURRENCY 11;
ALTER RESOURCE GROUP
COMMIT;
COMMIT
SELECT * FROM rg_alter_tran_status;
 groupname       | concurrency | cpu_max_percent | cpu_weight | cpuset | memory_limit | min_cost | io_limit 
-----------------+-------------+-----------------+------------+--------+--------------+----------+----------
 rg_alter_tran   | 11          | 11              | 110        | -1     | 7            | 10       | -1       
 rg_alter_tran_b | 21          | 11              | 120        | -1     | 8            | 20       | -1       
(2 rows)

