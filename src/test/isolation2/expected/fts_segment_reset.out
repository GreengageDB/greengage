-- This test verifies that FTS shouldn't issue failover to mirror when
-- the primary is taking long in the RESET state.

-- start_matchsubs
-- m/seg0 [0-9.]+:\d+/
-- s/seg0 [0-9.]+:\d+/seg0 IP:PORT/
-- end_matchsubs

-- Helper for the CPU check at the end of this test.  The ftsprobe worker is
-- a bgworker child of the QD postmaster.  A SELECT without a FROM always
-- runs on the QD, so the worker is visible to this function (any query over
-- a table, temp tables included, may get dispatched to a QE, where no
-- ftsprobe worker exists).  The 'start' call remembers the worker's pid and
-- CPU time in SD (per-session data); the 'end' call verifies the very same
-- worker is still running and that it burned at most 30% of one CPU in
-- between.  Anything unexpected errors out loudly, so a broken check can
-- never pass silently.
CREATE OR REPLACE LANGUAGE plpython3u;
CREATE
CREATE OR REPLACE FUNCTION fts_cpu_check(action text) RETURNS bool AS $$ import os, time 
def sample(expect_pid): # Backend processes inherit the postmaster's working directory, which # is the QD data directory.  Getting it without any query matters: # even SHOW is rewritten into a SELECT from pg_settings and gets # dispatched to the QEs, where it can fail while they recover. datadir = os.getcwd() master_pid = int(open(os.path.join(datadir, 'postmaster.pid')).readline()) for entry in os.listdir('/proc'): if not entry.isdigit(): continue try: stat = open('/proc/%s/stat' % entry).read() fields = stat[stat.rfind(')') + 2:].split() if int(fields[1]) != master_pid: continue cmd = open('/proc/%s/cmdline' % entry).read() if 'ftsprobe process' not in cmd: continue if expect_pid is not None and int(entry) != expect_pid: plpy.error('ftsprobe process restarted (%d -> %d)' % (expect_pid, int(entry))) return int(entry), (int(fields[11]) + int(fields[12])) \ / float(os.sysconf('SC_CLK_TCK')) except (OSError, ValueError, IndexError): continue        # process went away meanwhile plpy.error('ftsprobe process not found under postmaster pid %d' % master_pid) 
if action == 'start': pid, secs = sample(None) SD['start'] = (pid, secs, time.time()) return True elif action == 'end': try: pid0, secs0, t0 = SD['start'] except KeyError: plpy.error("fts_cpu_check('start') was not called") pid, secs = sample(pid0) return secs - secs0 <= 0.30 * (time.time() - t0) else: plpy.error("action must be 'start' or 'end'") $$ LANGUAGE plpython3u;
CREATE

-- Let FTS detect/declare failure sooner
!\retcode gpconfig -c gp_fts_probe_interval -v 10 --masteronly;
-- start_ignore
