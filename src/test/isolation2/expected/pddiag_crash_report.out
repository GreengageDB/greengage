-- remember the victim pid, then arm a panic on the next query of session 1;
-- the panic abort()s the backend and pddiag's SIGABRT handler dumps the report
1: CREATE TABLE pddiag_victim_pid(victim_pid int);
CREATE
1: INSERT INTO pddiag_victim_pid SELECT pg_backend_pid();
INSERT 1
1: select gp_inject_fault('exec_simple_query_start', 'panic', current_setting('gp_dbid')::smallint);
 gp_inject_fault 
-----------------
 Success:        
(1 row)
1: select 1;
PANIC:  fault triggered, fault name:'exec_simple_query_start' fault type:'panic'
server closed the connection unexpectedly
	This probably means the server terminated abnormally
	before or while processing the request.
-- session 1 is dead now; verify the report from a fresh session
2: SELECT substring(content from 1 for 15) AS report_header, position('signo=6' in content) > 0 AS has_signo, position('end.' in content) > 0 AS is_complete, position('trace log' in content) > 0 AS has_trace, (SELECT count(*) > 0 FROM regexp_matches(content, '  #[0-9]+ ', 'g')) AS has_trace_entries, (SELECT count(*) > 0 FROM regexp_matches(content, 'size=[1-9]', 'g')) AS has_sized_events FROM (SELECT pg_read_file(current_setting('log_directory') || '/pddiag-' || (SELECT victim_pid FROM pddiag_victim_pid) || '.log') AS content) r;
 report_header   | has_signo | is_complete | has_trace | has_trace_entries | has_sized_events 
-----------------+-----------+-------------+-----------+-------------------+------------------
 pddiag crash re | t         | t           | t         | t                 | t                
(1 row)
2: DROP TABLE pddiag_victim_pid;
DROP
