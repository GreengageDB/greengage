-- Deleted rows: scattered, whole batches and blocks, and all of them.
CREATE TABLE co_del USING ao_column AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
CREATE TABLE ao_del USING ao_row AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
DELETE FROM co_del WHERE i4 % 3 = 0 OR i4 BETWEEN -9000 AND -2000;
DELETE FROM ao_del WHERE i4 % 3 = 0 OR i4 BETWEEN -9000 AND -2000;
SELECT check_scan('co_del');
 check_scan 
