--
-- Read append-only tables by blocks from an extension. test_ao_scan_compare
-- reads a table this way and through tuple slots on every segment, and fails
-- when the two disagree on a value, so a check here passes when the rows
-- compared are those the table has.
--
CREATE EXTENSION test_ao_scan;
-- ORCA's notice on missing statistics depends on the plan, not on the scan.
SET optimizer_print_missing_stats = off;
CREATE FUNCTION check_scan(tab regclass, attnums int[] DEFAULT NULL) RETURNS text AS $$
DECLARE
	expected bigint;
	compared bigint;
BEGIN
	EXECUTE format('SELECT count(*) FROM %s', tab) INTO expected;
	SELECT coalesce(sum(n), 0) INTO compared FROM test_ao_scan_compare(tab, attnums) n;
	RETURN CASE WHEN compared = expected THEN expected || ' rows' ELSE
		compared || ' rows compared of ' || expected END;
END
$$ LANGUAGE plpgsql;
-- Negative values of every width, and the rows of the same tables on a heap
-- to check the slots themselves against.
CREATE TABLE src_plain AS
SELECT (i - 10000)::int2 AS i2, i - 10000 AS i4, (i::bigint - 10000) * 1000000000 AS i8,
	   date '2000-01-01' + (i - 10000) AS d, ((i - 10000) / 3.0)::float4 AS f4,
	   ((i - 10000) / 7.0)::float8 AS f8, i % 2 = 0 AS b, chr(65 + i % 26)::"char" AS ch,
	   'text ' || i AS t, (i / 3.0)::numeric(20, 5) AS n,
	   timestamp '2000-01-01' + (i - 10000) * interval '1 minute' AS ts
FROM generate_series(1, 20000) i DISTRIBUTED BY (i4);
CREATE TABLE src_nulls AS
SELECT CASE WHEN i4 % 7 = 0 THEN NULL ELSE i2 END AS i2,
	   CASE WHEN i4 % 5 = 0 THEN NULL ELSE i4 END AS i4k, i4,
	   CASE WHEN i4 % 3 = 0 THEN NULL ELSE i8 END AS i8,
	   CASE WHEN i4 % 4 = 0 THEN NULL ELSE t END AS t,
	   CASE WHEN i4 % 6 = 0 THEN NULL ELSE n END AS n
FROM src_plain DISTRIBUTED BY (i4);
-- Repeated values for RLE, values close to each other for delta.
CREATE TABLE src_runs AS
SELECT (-(i / 1000))::int2 AS i2, i AS i4, -(i / 500) AS i4r, (i / 100)::bigint - 500 AS i8,
	   date '2000-01-01' - (i / 300) AS d, 'run ' || (i / 200) AS t
FROM generate_series(1, 20000) i DISTRIBUTED BY (i4);
CREATE TABLE src_seq AS
SELECT i - 10000 AS i4, (i - 10000)::bigint * 3 AS i8, date '2000-01-01' + (i - 10000) / 10 AS d,
	   timestamp '2000-01-01' + i * interval '1 second' AS ts
FROM generate_series(1, 20000) i DISTRIBUTED BY (i4);
-- Values larger than a block among small ones.
CREATE TABLE src_large AS
SELECT i AS i4, CASE WHEN i % 50 = 0 THEN repeat(md5(i::text), 8000) ELSE 'short ' || i END AS t
FROM generate_series(1, 1000) i DISTRIBUTED BY (i4);
CREATE TABLE co_plain USING ao_column AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
CREATE TABLE ao_plain USING ao_row AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
CREATE TABLE co_small USING ao_column WITH (blocksize = 8192) AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
CREATE TABLE ao_small USING ao_row WITH (blocksize = 8192) AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
CREATE TABLE co_zlib USING ao_column WITH (compresstype = zlib, compresslevel = 1) AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
CREATE TABLE ao_zlib USING ao_row WITH (compresstype = zlib, compresslevel = 1) AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
CREATE TABLE co_nulls USING ao_column AS SELECT * FROM src_nulls DISTRIBUTED BY (i4);
CREATE TABLE ao_nulls USING ao_row AS SELECT * FROM src_nulls DISTRIBUTED BY (i4);
CREATE TABLE co_rle USING ao_column WITH (compresstype = rle_type, compresslevel = 1) AS SELECT * FROM src_runs DISTRIBUTED BY (i4);
CREATE TABLE co_rle_nulls USING ao_column WITH (compresstype = rle_type, compresslevel = 4) AS SELECT * FROM src_nulls DISTRIBUTED BY (i4);
CREATE TABLE co_delta USING ao_column WITH (compresstype = rle_type, compresslevel = 1) AS SELECT * FROM src_seq DISTRIBUTED BY (i4);
CREATE TABLE co_large USING ao_column AS SELECT * FROM src_large DISTRIBUTED BY (i4);
CREATE TABLE ao_large USING ao_row AS SELECT * FROM src_large DISTRIBUTED BY (i4);
CREATE TABLE co_large_zlib USING ao_column WITH (compresstype = zlib, compresslevel = 1) AS SELECT * FROM src_large DISTRIBUTED BY (i4);
CREATE TABLE ao_large_zlib USING ao_row WITH (compresstype = zlib, compresslevel = 1) AS SELECT * FROM src_large DISTRIBUTED BY (i4);
CREATE TABLE co_empty USING ao_column AS SELECT * FROM src_plain WHERE false DISTRIBUTED BY (i4);
CREATE TABLE ao_empty USING ao_row AS SELECT * FROM src_plain WHERE false DISTRIBUTED BY (i4);
SELECT check_scan('co_plain');
