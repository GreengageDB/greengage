-- Rows moved by VACUUM, with new ones after them.
CREATE TABLE co_vac USING ao_column AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
CREATE TABLE ao_vac USING ao_row AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
DELETE FROM co_vac WHERE i4 % 2 = 0;
DELETE FROM ao_vac WHERE i4 % 2 = 0;
VACUUM co_vac;
VACUUM ao_vac;
INSERT INTO co_vac SELECT * FROM src_plain WHERE i4 % 2 = 0;
INSERT INTO ao_vac SELECT * FROM src_plain WHERE i4 % 2 = 0;
SELECT check_scan('co_vac');
 check_scan 
------------
 20000 rows
(1 row)

SELECT check_scan('ao_vac');
 check_scan 
------------
 20000 rows
(1 row)

-- A gap in the row numbers, left by an aborted insert.
CREATE TABLE co_gap USING ao_column AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
CREATE TABLE ao_gap USING ao_row AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
BEGIN;
INSERT INTO co_gap SELECT * FROM src_plain;
INSERT INTO ao_gap SELECT * FROM src_plain;
ROLLBACK;
INSERT INTO co_gap SELECT * FROM src_plain;
INSERT INTO ao_gap SELECT * FROM src_plain;
SELECT check_scan('co_gap');
 check_scan 
------------
 40000 rows
(1 row)

SELECT check_scan('ao_gap');
 check_scan 
------------
 40000 rows
(1 row)

-- Attributes added later: missing values in the older rows, values of their
-- own in the newer ones. With only those read, the scan's anchor column is
-- one nobody asked for.
CREATE TABLE co_add USING ao_column AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
CREATE TABLE ao_add USING ao_row AS SELECT * FROM src_plain DISTRIBUTED BY (i4);
ALTER TABLE co_add ADD COLUMN x int2 DEFAULT -5, ADD COLUMN y text DEFAULT 'added';
ALTER TABLE ao_add ADD COLUMN x int2 DEFAULT -5, ADD COLUMN y text DEFAULT 'added';
INSERT INTO co_add SELECT *, -7, 'own' FROM src_plain;
INSERT INTO ao_add SELECT *, -7, 'own' FROM src_plain;
ALTER TABLE co_add ADD COLUMN z int8 DEFAULT 99;
ALTER TABLE ao_add ADD COLUMN z int8 DEFAULT 99;
ALTER TABLE co_add DROP COLUMN i8;
ALTER TABLE ao_add DROP COLUMN i8;
SELECT check_scan('co_add');
