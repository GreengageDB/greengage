--
-- Test that linked libpq library is properly compiled.
--
CREATE OR REPLACE FUNCTION is_backend()
  RETURNS BOOL
  AS '@abs_builddir@/regress@DLSUFFIX@',
     'gp_linked_libpq_is_compiled_for_backend'
  LANGUAGE C STRICT;
SELECT is_backend();
