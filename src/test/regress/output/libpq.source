DROP FUNCTION is_backend();
CREATE OR REPLACE FUNCTION check_events()
  RETURNS bool
  AS '@abs_builddir@/regress@DLSUFFIX@',
     'gp_check_libpq_events'
  LANGUAGE C STRICT;
SELECT check_events();
