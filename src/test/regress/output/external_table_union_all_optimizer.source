-- A filter on a coordinator-only external table under UNION ALL is evaluated
-- before the motion that moves the rows to the segments: ORCA can enforce the
-- motion on the output of the filter instead of on the scan below it.
CREATE TABLE filter_below_motion_heap(a int, b int, c text) DISTRIBUTED BY (a);
INSERT INTO filter_below_motion_heap SELECT i, i, 'row' || i FROM generate_series(1, 1000) i;
ANALYZE filter_below_motion_heap;
CREATE EXTERNAL WEB TABLE filter_below_motion_ext(a int, b int, c text)
EXECUTE 'seq 1 2000 | awk ''{print $1","$1",row"$1}''' ON COORDINATOR FORMAT 'csv';
EXPLAIN (COSTS OFF) SELECT * FROM (SELECT a, b, c FROM filter_below_motion_heap UNION ALL SELECT a, b, c FROM filter_below_motion_ext) u WHERE a = 5;
                        QUERY PLAN                         
-----------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Append
         ->  Seq Scan on filter_below_motion_heap
               Filter: (a = 5)
         ->  Redistribute Motion 1:3  (slice2)
               ->  Foreign Scan on filter_below_motion_ext
                     Filter: (a = 5)
 Optimizer: GPORCA
(8 rows)

SELECT * FROM (SELECT a, b, c FROM filter_below_motion_heap UNION ALL SELECT a, b, c FROM filter_below_motion_ext) u WHERE a = 5;
 a | b |  c   
---+---+------
 5 | 5 | row5
 5 | 5 | row5
(2 rows)

EXPLAIN (COSTS OFF) SELECT * FROM (SELECT a, b, c FROM filter_below_motion_heap UNION ALL SELECT a, b, c FROM filter_below_motion_ext) u WHERE a BETWEEN 998 AND 1002;
                         QUERY PLAN                         
------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Append
         ->  Seq Scan on filter_below_motion_heap
               Filter: ((a >= 998) AND (a <= 1002))
         ->  Redistribute Motion 1:3  (slice2)
               ->  Foreign Scan on filter_below_motion_ext
                     Filter: ((a >= 998) AND (a <= 1002))
 Optimizer: GPORCA
(8 rows)

SELECT * FROM (SELECT a, b, c FROM filter_below_motion_heap UNION ALL SELECT a, b, c FROM filter_below_motion_ext) u WHERE a BETWEEN 998 AND 1002 ORDER BY a;
  a   |  b   |    c    
------+------+---------
  998 |  998 | row998
  998 |  998 | row998
  999 |  999 | row999
  999 |  999 | row999
 1000 | 1000 | row1000
 1000 | 1000 | row1000
 1001 | 1001 | row1001
 1002 | 1002 | row1002
(8 rows)

DROP EXTERNAL WEB TABLE filter_below_motion_ext;
DROP TABLE filter_below_motion_heap;
