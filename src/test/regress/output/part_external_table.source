-- Test that foreign table statistic is used in estimation of selectivity.
create server file_server5 foreign data wrapper file_fdw;
create foreign table ft5 (
	a int,
	b int
) server file_server5
options ( filename '@abs_srcdir@/data/part3.csv', format 'csv');
create table part_stats (a int, b int) distributed by (a) partition by range (b) (start (0) end (30) every (10));
insert into part_stats select i, i % 20 from generate_series(1, 10000) i;
alter table part_stats exchange partition for (25) with table ft5;
analyze part_stats;
explain select * from part_stats where a in (5,10,15,20,25);
                                    QUERY PLAN                                     
-----------------------------------------------------------------------------------
 Append  (cost=0.00..70.00 rows=15 width=8)
   ->  Gather Motion 2:1  (slice1; segments: 2)  (cost=0.00..29.15 rows=5 width=8)
         ->  Seq Scan on part_stats_1_prt_1  (cost=0.00..29.08 rows=2 width=8)
               Filter: (a = ANY ('{5,10,15,20,25}'::integer[]))
   ->  Gather Motion 2:1  (slice2; segments: 2)  (cost=0.00..29.15 rows=5 width=8)
         ->  Seq Scan on part_stats_1_prt_2  (cost=0.00..29.08 rows=2 width=8)
               Filter: (a = ANY ('{5,10,15,20,25}'::integer[]))
   ->  Foreign Scan on part_stats_1_prt_3  (cost=0.00..11.63 rows=5 width=8)
         Filter: (a = ANY ('{5,10,15,20,25}'::integer[]))
         Foreign File: @abs_srcdir@/data/part3.csv
         Foreign File Size: 592 b
 Optimizer: Postgres-based planner
(12 rows)

-- A get must be estimated from the partitions it scans, not from the root:
-- the heap side must not include the foreign leaf's rows and vice versa.
-- A web external table cannot be analyzed, so its rows are missing from the
-- root's statistics.
create table part_web (a int, b int) distributed by (a)
	partition by range (b) (start (0) end (30) every (10));
insert into part_web select i, i % 20 from generate_series(1, 10000) i;
create external web table p3_web (a int, b int)
	execute 'seq 1 100 | awk ''{print $1","20+($1%10)}''' on coordinator format 'csv';
alter table part_web exchange partition for (25) with table p3_web;
NOTICE:  partition constraints are not validated when attaching a readable external table
analyze part_web;
WARNING:  skipping "part_web_1_prt_3" --- cannot analyze this foreign table
explain select * from part_web;
                                      QUERY PLAN                                      
--------------------------------------------------------------------------------------
 Append  (cost=0.00..220.68 rows=10001 width=8)
   ->  Gather Motion 3:1  (slice1; segments: 3)  (cost=0.00..85.33 rows=5000 width=8)
         ->  Seq Scan on part_web_1_prt_1  (cost=0.00..18.67 rows=1667 width=8)
   ->  Gather Motion 3:1  (slice2; segments: 3)  (cost=0.00..85.33 rows=5000 width=8)
         ->  Seq Scan on part_web_1_prt_2  (cost=0.00..18.67 rows=1667 width=8)
   ->  Foreign Scan on part_web_1_prt_3  (cost=0.00..0.01 rows=1 width=8)
 Optimizer: Postgres-based planner
(7 rows)

