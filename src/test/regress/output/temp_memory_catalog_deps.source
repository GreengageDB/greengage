--
-- TEMP_MEMORY_CATALOG_DEPS
-- The dependency rows of temporary objects are virtual like every other
-- row of the object, and their edges are published to a shared-memory
-- registry: another session can neither see the rows nor drop or alter a
-- referenced shared object (column type, index expression function, owner
-- role, domain) while the owning session is alive.  The registry also
-- guarantees that the owner keeps access to its own objects, that
-- cascades and ALTER recursion are refused rather than silently skipped,
-- and that ACL edges of temporary objects stay off disk.
--
-- The second backend is kept connected by tempcat_dep_session_exec(), so
-- the temporary table metadata in its memory stays alive while this
-- session attempts the drops.  Expected errors are asserted in DO blocks
-- because their DETAIL lines contain OIDs that are not stable across runs.
--
CREATE FUNCTION tempcat_dep_session_exec(text) RETURNS text
	AS '@abs_builddir@/regress@DLSUFFIX@', 'tempcat_dep_session_exec'
	LANGUAGE C STRICT;
CREATE FUNCTION tempcat_dep_session_disconnect() RETURNS void
	AS '@abs_builddir@/regress@DLSUFFIX@', 'tempcat_dep_session_disconnect'
	LANGUAGE C;
-- Assert that a statement fails with ERRCODE_DEPENDENT_OBJECTS_STILL_EXIST
-- and its message mentions needle.
CREATE FUNCTION tempcat_assert_blocked(stmt text, needle text) RETURNS void
AS $$
BEGIN
	EXECUTE stmt;
	RAISE EXCEPTION 'statement unexpectedly succeeded: %', stmt;
EXCEPTION WHEN dependent_objects_still_exist THEN
	IF position(needle in SQLERRM) = 0 THEN
		RAISE EXCEPTION 'wrong error message: %', SQLERRM;
	END IF;
END;
$$ LANGUAGE plpgsql;
-- Run a DROP that may transiently fail with ERRCODE_DEPENDENT_OBJECTS_
-- STILL_EXIST while the second session's segment backends finish their
-- exit cleanup, until they have.
CREATE FUNCTION tempcat_retry_drop(stmt text) RETURNS void AS $$
DECLARE
	tries int := 0;
BEGIN
	LOOP
		BEGIN
			EXECUTE stmt;
			RETURN;
		EXCEPTION WHEN dependent_objects_still_exist THEN
			tries := tries + 1;
			IF tries >= 100 THEN
				RAISE EXCEPTION 'still blocked after retries: %', stmt;
			END IF;
			PERFORM pg_sleep(0.1);
		END;
	END LOOP;
END;
$$ LANGUAGE plpgsql;
-- Objects that the temporary tables will depend on
CREATE TYPE dty AS (x int);
CREATE FUNCTION dfn(int) RETURNS int IMMUTABLE LANGUAGE sql AS 'SELECT $1 + 1';
