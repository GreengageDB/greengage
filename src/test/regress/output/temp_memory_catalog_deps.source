-- Virtual catalog changes do not show up in pg_stat heap counters, so
-- autovacuum does not chase them.
CREATE FUNCTION tempcat_assert_stat_unchanged() RETURNS int
AS $$
DECLARE
	before_ins bigint;
	after_ins bigint;
BEGIN
	SELECT pg_stat_get_tuples_inserted('pg_attribute'::regclass) INTO before_ins;
	PERFORM tempcat_dep_session_exec('CREATE TEMP TABLE dep_stat (a int PRIMARY KEY) DISTRIBUTED BY (a)');
	PERFORM tempcat_dep_session_exec('DROP TABLE dep_stat');
	SELECT pg_stat_get_tuples_inserted('pg_attribute'::regclass) INTO after_ins;
	IF before_ins <> after_ins THEN
		RAISE EXCEPTION 'pg_attribute insert counter moved: % to %', before_ins, after_ins;
	END IF;
	RETURN after_ins - before_ins;
END;
$$ LANGUAGE plpgsql;
SELECT tempcat_assert_stat_unchanged() AS stat_delta;
 stat_delta 
------------
          0
(1 row)

DROP FUNCTION tempcat_assert_stat_unchanged();
-- Disconnect session A: its backend exit drops the temporary tables and
-- with them the dependency rows (the exit cleanup is asynchronous, so wait
-- for it).
SELECT tempcat_dep_session_disconnect();
 tempcat_dep_session_disconnect 
--------------------------------
 
(1 row)

DO $$
DECLARE
	n int := 1;
	tries int := 0;
BEGIN
	WHILE n > 0 AND tries < 100 LOOP
		SELECT count(*) INTO n FROM pg_shdepend
		 WHERE refclassid = 'pg_authid'::regclass
		   AND refobjid = (SELECT oid FROM pg_roles WHERE rolname = 'drole')
		   AND deptype = 'o';
		IF n > 0 THEN
			PERFORM pg_sleep(0.1);
			tries := tries + 1;
		END IF;
	END LOOP;
	IF n > 0 THEN
		RAISE EXCEPTION 'second session exit cleanup did not complete';
	END IF;
END;
$$;
-- The objects A's edges blocked become droppable again; the edges can
-- linger a moment while A's gangs tear down, so retry.
DO $$
DECLARE
	tries int := 0;
BEGIN
	LOOP
		BEGIN
			EXECUTE 'DROP TABLE dep_seqt';
			EXECUTE 'DROP TABLE dep_parent';
			EXECUTE 'DROP TYPE dep_type CASCADE';
			EXECUTE 'DROP TABLE dep_anlz';
			EXECUTE 'DROP TABLE dep_altv';
			EXIT;
		EXCEPTION WHEN dependent_objects_still_exist THEN
			tries := tries + 1;
			IF tries > 20 THEN
				RAISE;
			END IF;
			PERFORM pg_sleep(0.5);
		END;
	END LOOP;
END;
$$;
