-- start_ignore
-- One raw demonstration of the reporting, ignored in the diff because the
-- DETAIL line contains the temporary table's OID.
DROP TYPE dty;
ERROR:  cannot drop type dty because temporary objects in other sessions depend on it
DETAIL:  column 2 of temporary relation 17589 in another session depends on type dty
HINT:  Disconnect the session that holds the temporary objects, or drop them in it, and retry.
-- end_ignore
-- Every row of a temporary object is virtual, not just its pg_class rows:
-- while session A holds them, this session sees no pg_attrdef,
-- pg_constraint, pg_trigger, pg_rewrite, pg_sequence or pg_description rows
-- for them either.
CREATE TABLE dep_probe(k text, v bigint);
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'k' as the Greengage Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
CREATE FUNCTION dfn2(int) RETURNS int IMMUTABLE LANGUAGE sql AS 'SELECT $1 + 2';
CREATE FUNCTION dfn3(int) RETURNS int IMMUTABLE LANGUAGE sql AS 'SELECT $1 + 3';
CREATE FUNCTION dfn4() RETURNS trigger AS $t$ BEGIN RETURN NULL; END $t$ LANGUAGE plpgsql;
CREATE DOMAIN ddom AS int;
SELECT tempcat_dep_session_exec($q$
	CREATE TEMP TABLE dep_td (a int DEFAULT dfn2(1)) DISTRIBUTED BY (a);
	CREATE TEMP TABLE dep_tc (a int CHECK (dfn3(a) > 0)) DISTRIBUTED BY (a);
	CREATE TEMP TABLE dep_tt (a int) DISTRIBUTED BY (a);
	CREATE TRIGGER dep_tg BEFORE INSERT ON dep_tt
		FOR EACH ROW EXECUTE PROCEDURE dfn4();
	COMMENT ON TABLE dep_tt IS 'temporary';
	CREATE TEMP VIEW dep_tv AS SELECT a FROM dep_tt;
	CREATE TEMP SEQUENCE dep_ts;
	CREATE TEMP TABLE dep_tdm (a ddom) DISTRIBUTED BY (a);
	INSERT INTO dep_probe
		SELECT 'td', 'dep_td'::regclass UNION ALL
		SELECT 'tc', 'dep_tc'::regclass UNION ALL
		SELECT 'tt', 'dep_tt'::regclass UNION ALL
		SELECT 'tv', 'dep_tv'::regclass UNION ALL
		SELECT 'ts', 'dep_ts'::regclass;
$q$);
