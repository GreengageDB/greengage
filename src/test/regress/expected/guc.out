$$ select current_setting($1) $$ language sql
set work_mem = '1MB';
WARNING:  "work_mem": setting is deprecated, and may be removed in a future release.
WARNING:  "work_mem": setting is deprecated, and may be removed in a future release.
select report_guc('work_mem'), current_setting('work_mem');
