                                               ^
QUERY:  explain (analyze, verbose, buffers, format json)
                         select * from tenk1 order by tenthous
CONTEXT:  PL/pgSQL function explain_filter_to_json(text) line 6 at FOR over EXECUTE statement
rollback;
