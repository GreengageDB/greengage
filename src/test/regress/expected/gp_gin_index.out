DROP INDEX jidx;
-- check some corner cases for indexed nested containment (bug #13756)
create temp table nestjsonb (j jsonb);
insert into nestjsonb (j) values ('{"a":[["b",{"x":1}],["b",{"x":2}]],"c":3}');
insert into nestjsonb (j) values ('[[14,2,3]]');
insert into nestjsonb (j) values ('[1,[14,2,3]]');
create index on nestjsonb using gin(j jsonb_path_ops);
explain select * from nestjsonb where j @> '{"a":[[{"x":2}]]}'::jsonb;
                                      QUERY PLAN                                       
---------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)  (cost=16.00..59.24 rows=528 width=32)
   ->  Bitmap Heap Scan on nestjsonb  (cost=16.00..52.20 rows=176 width=32)
         Recheck Cond: (j @> '{"a": [[{"x": 2}]]}'::jsonb)
         ->  Bitmap Index Scan on nestjsonb_j_idx  (cost=0.00..15.96 rows=176 width=0)
               Index Cond: (j @> '{"a": [[{"x": 2}]]}'::jsonb)
 Optimizer: Postgres query optimizer
(6 rows)

