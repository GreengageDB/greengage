-- UPDATE on view with rule
EXPLAIN (verbose, costs off)
UPDATE joinview SET f3 = f3 + 1 WHERE f3 = 57
  RETURNING old.*, new.*, *, new.f3 - old.f3 AS delta_f3;
                                                                                     QUERY PLAN                                                                                      
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Output: f1, f2, f3, f4, (joinme.other), f1, f2, f3, f4, (joinme.other), foo_1.f1, foo_1.f2, foo_1.f3, foo_1.f4, joinme.other, ((f3 - f3))
   ->  Update on pg_temp.foo
         Output: old.f1, old.f2, old.f3, old.f4, joinme.other, new.f1, new.f2, new.f3, new.f4, joinme.other, foo_1.f1, foo_1.f2, foo_1.f3, foo_1.f4, joinme.other, (new.f3 - old.f3)
         Update on pg_temp.foo foo_1
         ->  Explicit Redistribute Motion 3:3  (slice2; segments: 3)
               Output: foo_2.f1, ((foo_2.f3 + 1)), joinme.ctid, foo_2.ctid, joinme_1.ctid, joinme.other, foo_1.tableoid, foo_1.ctid, foo_1.gp_segment_id, foo_2.tableoid
               ->  Hash Join
                     Output: foo_2.f1, (foo_2.f3 + 1), joinme.ctid, foo_2.ctid, joinme_1.ctid, joinme.other, foo_1.tableoid, foo_1.ctid, foo_1.gp_segment_id, foo_2.tableoid
                     Hash Cond: (foo_1.f2 = foo_2.f2)
                     ->  Hash Join
                           Output: foo_1.f2, foo_1.tableoid, foo_1.ctid, foo_1.gp_segment_id, joinme.ctid, joinme.other, joinme.f2j
                           Hash Cond: (foo_1.f2 = joinme.f2j)
                           ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                 Output: foo_1.f2, foo_1.tableoid, foo_1.ctid, foo_1.gp_segment_id
                                 Hash Key: foo_1.f2
                                 ->  Seq Scan on pg_temp.foo foo_1
                                       Output: foo_1.f2, foo_1.tableoid, foo_1.ctid, foo_1.gp_segment_id
                           ->  Hash
                                 Output: joinme.ctid, joinme.other, joinme.f2j
                                 ->  Seq Scan on pg_temp.joinme
                                       Output: joinme.ctid, joinme.other, joinme.f2j
                     ->  Hash
                           Output: foo_2.f1, foo_2.f3, foo_2.ctid, foo_2.f2, foo_2.tableoid, joinme_1.ctid, joinme_1.f2j
                           ->  Hash Join
                                 Output: foo_2.f1, foo_2.f3, foo_2.ctid, foo_2.f2, foo_2.tableoid, joinme_1.ctid, joinme_1.f2j
                                 Hash Cond: (joinme_1.f2j = foo_2.f2)
                                 ->  Seq Scan on pg_temp.joinme joinme_1
                                       Output: joinme_1.ctid, joinme_1.f2j
                                 ->  Hash
                                       Output: foo_2.f1, foo_2.f3, foo_2.ctid, foo_2.f2, foo_2.tableoid
                                       ->  Redistribute Motion 3:3  (slice4; segments: 3)
                                             Output: foo_2.f1, foo_2.f3, foo_2.ctid, foo_2.f2, foo_2.tableoid
                                             Hash Key: foo_2.f2
                                             ->  Seq Scan on pg_temp.foo foo_2
                                                   Output: foo_2.f1, foo_2.f3, foo_2.ctid, foo_2.f2, foo_2.tableoid
                                                   Filter: (foo_2.f3 = 57)
 Optimizer: Postgres query optimizer
