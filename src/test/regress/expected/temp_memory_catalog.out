------------+-----------+--------------------
 sad        | happy     | {sad,meh,ok,happy}
(1 row)

SELECT count(*) AS labels, bool_and((ctid::text::point)[1] >= 32768) AS in_memory
  FROM pg_enum WHERE enumtypid = 'pg_temp.tc_mood'::regtype;
