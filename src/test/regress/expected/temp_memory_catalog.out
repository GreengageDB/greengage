-- Creating and dropping in one transaction frees the dead rows on the way.
DO $$
BEGIN
  FOR i IN 1..500 LOOP
    EXECUTE format('CREATE TEMP TABLE tc_cycle (a int PRIMARY KEY, b text) DISTRIBUTED BY (a)');
    EXECUTE 'DROP TABLE tc_cycle';
  END LOOP;
END $$;
