-- Ordinary objects cannot depend on temporary objects kept in memory, nor
-- can those inherit from or be typed by ordinary ones.
CREATE TYPE tc_ord_comp AS (x int);
CREATE TABLE tc_ord_parent (a int) DISTRIBUTED BY (a);
CREATE FUNCTION public.tc_bad(pg_temp.tc_comp) RETURNS int LANGUAGE sql AS 'SELECT 1';
ERROR:  ordinary objects cannot depend on temporary objects kept in memory
DETAIL:  The new object would depend on type tc_comp.
HINT:  Turn off gp_enable_temp_memory_catalog before the session creates its first temporary object.
CREATE TABLE tc_bad_t (c pg_temp.tc_comp) DISTRIBUTED RANDOMLY;
ERROR:  ordinary objects cannot depend on temporary objects kept in memory
DETAIL:  The new object would depend on type tc_comp.
HINT:  Turn off gp_enable_temp_memory_catalog before the session creates its first temporary object.
CREATE TEMP TABLE tc_child () INHERITS (tc_ord_parent);
NOTICE:  table has parent, setting distribution columns to match parent table
ERROR:  temporary tables kept in memory cannot inherit from ordinary table "tc_ord_parent"
HINT:  Turn off gp_enable_temp_memory_catalog before the session creates its first temporary object.
CREATE TEMP TABLE tc_of OF tc_ord_comp;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'x' as the Greengage Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
ERROR:  temporary tables kept in memory cannot be typed tables of ordinary type tc_ord_comp
HINT:  Turn off gp_enable_temp_memory_catalog before the session creates its first temporary object.
CREATE CAST (pg_temp.tc_comp AS text) WITH INOUT;
ERROR:  casts are not supported for temporary objects kept in memory
HINT:  Turn off gp_enable_temp_memory_catalog before the session creates its first temporary object.
ALTER EXTENSION plpgsql ADD FUNCTION pg_temp.tc_f(pg_temp.tc_dom);
ERROR:  extension members are not supported for temporary objects kept in memory
HINT:  Turn off gp_enable_temp_memory_catalog before the session creates its first temporary object.
CREATE STATISTICS pg_temp.tc_stx ON a FROM tc_ord_parent;
ERROR:  statistics object on an ordinary table cannot be in a temporary schema kept in memory
CREATE TEMP TABLE tc_inh_parent (a int) DISTRIBUTED BY (a);
CREATE TEMP TABLE tc_inh_child () INHERITS (tc_inh_parent);
NOTICE:  table has parent, setting distribution columns to match parent table
