  FROM pg_attribute a1 JOIN pg_attribute a2 ON a1.attrelid = a2.attrelid
 WHERE a1.attrelid IN ('pg_class'::regclass, 'tc_t'::regclass, 'pg_type'::regclass, 'tc_t_pkey'::regclass);
