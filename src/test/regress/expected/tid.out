-- tests for functions related to TID handling
CREATE TABLE tid_tab (a int, b int default 0) distributed by (b);
-- min() and max() for TIDs
INSERT INTO tid_tab VALUES (1), (2);
SELECT min(ctid) FROM tid_tab;
