--
-- Range partition bounds must be compared using the partition key's
-- collation, not the database default collation.
--
-- To catch that whatever the database default is, every scenario runs twice:
-- once with a "C" key and once with an en_US.utf8 key. At least one of the
-- two differs from the default. On the en_US key only distinct letters are
-- compared, because glibc versions disagree on how 'a' and 'A' are ordered.
--
-- en_US.utf8 orders 'a' < 'B' < 'c', while "C" orders 'B' < 'a' < 'c'.
--
create schema partition_collation;
set search_path = partition_collation;
set client_min_messages = warning;
create collation coll_en (locale = 'en_US.utf8');
--
-- Routing.
--
-- "C" key: 'B' sorts before 'a', so it belongs to the default partition.
-- With an en_US default, inserting it used to fail.
create table rp_c (id int, k text collate "C")
distributed by (id)
partition by range (k)
(partition p1 start ('a') end ('c'),
 default partition other);
insert into rp_c values (1, 'B'), (2, 'a'), (3, 'b'), (4, 'd');
-- The tableoid queries show which partition each row was stored in. A row in
-- the wrong partition is still returned by queries on the parent table, so
-- checking query results alone would not catch it.
select tableoid::regclass, * from rp_c order by id;
     tableoid     | id | k 
------------------+----+---
 rp_c_1_prt_other |  1 | B
 rp_c_1_prt_p1    |  2 | a
 rp_c_1_prt_p1    |  3 | b
 rp_c_1_prt_other |  4 | d
(4 rows)

-- en_US key: 'B' sorts between 'a' and 'c', so it belongs to p1. With a "C"
-- default it used to be put in the default partition without any error.
create table rp_en (id int, k text collate coll_en)
distributed by (id)
partition by range (k)
(partition p1 start ('a') end ('c'),
 default partition other);
insert into rp_en values (1, 'B'), (2, 'a'), (3, 'b'), (4, 'd');
select tableoid::regclass, * from rp_en order by id;
     tableoid      | id | k 
-------------------+----+---
 rp_en_1_prt_p1    |  1 | B
 rp_en_1_prt_p1    |  2 | a
 rp_en_1_prt_p1    |  3 | b
 rp_en_1_prt_other |  4 | d
(4 rows)

--
-- COPY, and UPDATE of the partitioning key, must route rows the same way.
--
create table rp_c_dml (id int, k text collate "C")
distributed by (id)
partition by range (k)
(partition p1 start ('a') end ('c'),
 default partition other);
copy rp_c_dml from stdin;
select tableoid::regclass, * from rp_c_dml order by id;
       tableoid       | id | k 
----------------------+----+---
 rp_c_dml_1_prt_other |  1 | B
 rp_c_dml_1_prt_p1    |  2 | a
(2 rows)

-- Row 1 moves into p1 and row 2 moves into the default partition. Moving a
-- row to another partition with UPDATE is only supported by GPORCA.
set optimizer = on;
update rp_c_dml set k = 'b' where id = 1;
update rp_c_dml set k = 'B' where id = 2;
reset optimizer;
select tableoid::regclass, * from rp_c_dml order by id;
       tableoid       | id | k 
----------------------+----+---
 rp_c_dml_1_prt_p1    |  1 | b
 rp_c_dml_1_prt_other |  2 | B
(2 rows)

create table rp_en_dml (id int, k text collate coll_en)
distributed by (id)
partition by range (k)
(partition p1 start ('a') end ('c'),
 default partition other);
copy rp_en_dml from stdin;
select tableoid::regclass, * from rp_en_dml order by id;
       tableoid        | id | k 
-----------------------+----+---
 rp_en_dml_1_prt_p1    |  1 | B
 rp_en_dml_1_prt_other |  2 | d
(2 rows)

-- Row 1 moves into the default partition and row 2 moves into p1.
set optimizer = on;
update rp_en_dml set k = 'd' where id = 1;
update rp_en_dml set k = 'B' where id = 2;
reset optimizer;
select tableoid::regclass, * from rp_en_dml order by id;
       tableoid        | id | k 
-----------------------+----+---
 rp_en_dml_1_prt_other |  1 | d
 rp_en_dml_1_prt_p1    |  2 | B
(2 rows)

--
-- CREATE with bounds that are only ordered correctly under the key's
-- collation. These used to fail with "START greater than END".
--
create table rp_c_bounds (id int, k text collate "C")
distributed by (id)
partition by range (k)
(partition p1 start ('B') end ('a'),
 partition p2 start ('a') end ('z'));
insert into rp_c_bounds values (1, 'B'), (2, 'b'), (3, 'Zz'), (4, 'a');
select tableoid::regclass, * from rp_c_bounds order by id;
       tableoid       | id | k  
----------------------+----+----
 rp_c_bounds_1_prt_p1 |  1 | B
 rp_c_bounds_1_prt_p2 |  2 | b
 rp_c_bounds_1_prt_p1 |  3 | Zz
 rp_c_bounds_1_prt_p2 |  4 | a
(4 rows)

create table rp_en_bounds (id int, k text collate coll_en)
distributed by (id)
partition by range (k)
(partition p1 start ('a') end ('B'),
 partition p2 start ('B') end ('z'));
insert into rp_en_bounds values (1, 'aZ'), (2, 'Bb'), (3, 'c');
select tableoid::regclass, * from rp_en_bounds order by id;
       tableoid        | id | k  
-----------------------+----+----
 rp_en_bounds_1_prt_p1 |  1 | aZ
 rp_en_bounds_1_prt_p2 |  2 | Bb
 rp_en_bounds_1_prt_p2 |  3 | c
(3 rows)

--
-- ADD PARTITION must check the new bounds with the key's collation too.
-- These used to fail with "new partition overlaps existing partition".
--
create table rp_c_add (id int, k text collate "C")
distributed by (id)
partition by range (k)
(partition p2 start ('a') end ('z'));
alter table rp_c_add add partition p1 start ('B') end ('a');
insert into rp_c_add values (1, 'B'), (2, 'b');
select tableoid::regclass, * from rp_c_add order by id;
     tableoid      | id | k 
-------------------+----+---
 rp_c_add_1_prt_p1 |  1 | B
 rp_c_add_1_prt_p2 |  2 | b
(2 rows)

create table rp_en_add (id int, k text collate coll_en)
distributed by (id)
partition by range (k)
(partition p2 start ('B') end ('z'));
alter table rp_en_add add partition p1 start ('a') end ('B');
insert into rp_en_add values (1, 'aZ'), (2, 'c');
select tableoid::regclass, * from rp_en_add order by id;
      tableoid      | id | k  
--------------------+----+----
 rp_en_add_1_prt_p1 |  1 | aZ
 rp_en_add_1_prt_p2 |  2 | c
(2 rows)

--
-- SPLIT PARTITION AT must check that the AT value is inside the partition
-- with the key's collation. These used to fail with "AT clause parameter is
-- not a member of the target partition specification".
--
create table rp_c_split (id int, k text collate "C")
distributed by (id)
partition by range (k)
(partition p1 start ('B') end ('a'),
 partition p2 start ('a') end ('z'));
alter table rp_c_split split partition p1 at ('Q') into (partition p1a, partition p1b);
insert into rp_c_split values (1, 'C'), (2, 'R'), (3, 'b');
select tableoid::regclass, * from rp_c_split order by id;
       tableoid       | id | k 
----------------------+----+---
 rp_c_split_1_prt_p1a |  1 | C
 rp_c_split_1_prt_p1b |  2 | R
 rp_c_split_1_prt_p2  |  3 | b
(3 rows)

create table rp_en_split (id int, k text collate coll_en)
distributed by (id)
partition by range (k)
(partition p1 start ('a') end ('z'));
alter table rp_en_split split partition p1 at ('C') into (partition p1a, partition p1b);
insert into rp_en_split values (1, 'b'), (2, 'D');
select tableoid::regclass, * from rp_en_split order by id;
       tableoid        | id | k 
-----------------------+----+---
 rp_en_split_1_prt_p1a |  1 | b
 rp_en_split_1_prt_p1b |  2 | D
(2 rows)

--
-- SPLIT DEFAULT PARTITION must check the new bounds with the key's collation
-- and move the matching rows out of the default partition.
--
create table rp_c_split_def (id int, k text collate "C")
distributed by (id)
partition by range (k)
(partition p2 start ('a') end ('z'),
 default partition other);
insert into rp_c_split_def values (1, 'B'), (2, 'zz');
alter table rp_c_split_def split default partition start ('B') end ('a')
into (partition other, partition p1);
select tableoid::regclass, * from rp_c_split_def order by id;
          tableoid          | id | k  
----------------------------+----+----
 rp_c_split_def_1_prt_p1    |  1 | B
 rp_c_split_def_1_prt_other |  2 | zz
(2 rows)

create table rp_en_split_def (id int, k text collate coll_en)
distributed by (id)
partition by range (k)
(partition p2 start ('B') end ('z'),
 default partition other);
insert into rp_en_split_def values (1, 'aZ'), (2, 'zz');
alter table rp_en_split_def split default partition start ('a') end ('B')
into (partition other, partition p1);
select tableoid::regclass, * from rp_en_split_def order by id;
          tableoid           | id | k  
-----------------------------+----+----
 rp_en_split_def_1_prt_p1    |  1 | aZ
 rp_en_split_def_1_prt_other |  2 | zz
(2 rows)

--
-- PARTITION FOR (value) must find the partition with the key's collation.
-- Both collations order these bounds the same way, but 'C' sorts before 'b'
-- in "C" and after 'b' in en_US.utf8.
--
create table rp_c_for (id int, k text collate "C")
distributed by (id)
partition by range (k)
(partition p1 start ('0') end ('b'),
 partition p2 start ('b') end ('z'));
insert into rp_c_for values (1, 'a'), (2, 'x');
-- 'C' is in p1, so only row 1 is removed.
alter table rp_c_for truncate partition for ('C');
select tableoid::regclass, * from rp_c_for order by id;
     tableoid      | id | k 
-------------------+----+---
 rp_c_for_1_prt_p2 |  2 | x
(1 row)

create table rp_en_for (id int, k text collate coll_en)
distributed by (id)
partition by range (k)
(partition p1 start ('0') end ('b'),
 partition p2 start ('b') end ('z'));
insert into rp_en_for values (1, 'a'), (2, 'x');
-- 'C' is in p2, so only row 2 is removed.
alter table rp_en_for truncate partition for ('C');
select tableoid::regclass, * from rp_en_for order by id;
      tableoid      | id | k 
--------------------+----+---
 rp_en_for_1_prt_p1 |  1 | a
(1 row)

--
-- Each partitioning level must use the collation of its own key column. Here
-- the first level has a "C" key and the second level an en_US.utf8 key, with
-- the same bounds on both levels: 'C' sorts before 'b' in "C" and after 'b'
-- in en_US.utf8.
--
create table rp_sub (id int, k1 text collate "C", k2 text collate coll_en)
distributed by (id)
partition by range (k1)
subpartition by range (k2)
subpartition template
(subpartition s1 start ('0') end ('b'),
 subpartition s2 start ('b') end ('z'))
(partition p1 start ('0') end ('b'),
 partition p2 start ('b') end ('z'));
-- Row 1 belongs to p1 and s2, row 2 to p2 and s1.
insert into rp_sub values (1, 'C', 'C'), (2, 'x', 'a');
select tableoid::regclass, * from rp_sub order by id;
         tableoid         | id | k1 | k2 
--------------------------+----+----+----
 rp_sub_1_prt_p1_2_prt_s2 |  1 | C  | C
 rp_sub_1_prt_p2_2_prt_s1 |  2 | x  | a
(2 rows)

--
-- Tables created by earlier versions have the database default collation
-- stored in their boundaries. Rows must still be routed, and ALTER TABLE must
-- still compare boundaries, using the key's collation. To get such boundaries,
-- copy them from a table with the same boundaries and a default-collation key.
--
set allow_system_table_mods = on;
create function copy_bounds(target regclass, source regclass) returns void
language sql as $$
	update pg_partition_rule r
	set parrangestart = s.parrangestart, parrangeend = s.parrangeend
	from pg_partition p, pg_partition ps, pg_partition_rule s
	where r.paroid = p.oid and p.parrelid = target
	  and s.paroid = ps.oid and ps.parrelid = source
	  and s.parname = r.parname;
$$;
create table rp_c_old (id int, k text collate "C")
distributed by (id)
partition by range (k)
(partition p1 start ('0') end ('b'),
 partition p2 start ('b') end ('z'));
create table rp_c_old_add (id int, k text collate "C")
distributed by (id)
partition by range (k)
(partition p2 start ('a') end ('z'));
create table rp_en_old (id int, k text collate coll_en)
distributed by (id)
partition by range (k)
(partition p1 start ('0') end ('b'),
 partition p2 start ('b') end ('z'));
create table rp_en_old_add (id int, k text collate coll_en)
distributed by (id)
partition by range (k)
(partition p2 start ('B') end ('z'));
create table rp_def_old (id int, k text)
distributed by (id)
partition by range (k)
(partition p1 start ('0') end ('b'),
 partition p2 start ('b') end ('z'));
create table rp_def_old_c_add (id int, k text)
distributed by (id)
partition by range (k)
(partition p2 start ('a') end ('z'));
create table rp_def_old_en_add (id int, k text)
distributed by (id)
partition by range (k)
(partition p2 start ('B') end ('z'));
select copy_bounds('rp_c_old', 'rp_def_old');
 copy_bounds 
-------------
 
(1 row)

select copy_bounds('rp_en_old', 'rp_def_old');
 copy_bounds 
-------------
 
(1 row)

select copy_bounds('rp_c_old_add', 'rp_def_old_c_add');
 copy_bounds 
-------------
 
(1 row)

select copy_bounds('rp_en_old_add', 'rp_def_old_en_add');
 copy_bounds 
-------------
 
(1 row)

reset allow_system_table_mods;
-- The copied boundaries are shown without COLLATE.
select tablename, partitionname, partitionrangestart, partitionrangeend
from pg_partitions
where schemaname = 'partition_collation'
  and tablename in ('rp_c_old', 'rp_en_old', 'rp_c_old_add', 'rp_en_old_add')
order by tablename, partitionname;
   tablename   | partitionname | partitionrangestart | partitionrangeend 
---------------+---------------+---------------------+-------------------
 rp_c_old      | p1            | '0'::text           | 'b'::text
 rp_c_old      | p2            | 'b'::text           | 'z'::text
 rp_c_old_add  | p2            | 'a'::text           | 'z'::text
 rp_en_old     | p1            | '0'::text           | 'b'::text
 rp_en_old     | p2            | 'b'::text           | 'z'::text
 rp_en_old_add | p2            | 'B'::text           | 'z'::text
(6 rows)

-- 'C' sorts before 'b' in "C" and after 'b' in en_US.utf8.
insert into rp_c_old values (1, 'a'), (2, 'x'), (3, 'C');
select tableoid::regclass, * from rp_c_old order by id;
     tableoid      | id | k 
-------------------+----+---
 rp_c_old_1_prt_p1 |  1 | a
 rp_c_old_1_prt_p2 |  2 | x
 rp_c_old_1_prt_p1 |  3 | C
(3 rows)

alter table rp_c_old truncate partition for ('C');
alter table rp_c_old split partition p1 at ('C') into (partition p1a, partition p1b);
select tableoid::regclass, * from rp_c_old order by id;
     tableoid      | id | k 
-------------------+----+---
 rp_c_old_1_prt_p2 |  2 | x
(1 row)

insert into rp_en_old values (1, 'a'), (2, 'x'), (3, 'C');
select tableoid::regclass, * from rp_en_old order by id;
      tableoid      | id | k 
--------------------+----+---
 rp_en_old_1_prt_p1 |  1 | a
 rp_en_old_1_prt_p2 |  2 | x
 rp_en_old_1_prt_p2 |  3 | C
(3 rows)

alter table rp_en_old truncate partition for ('C');
alter table rp_en_old split partition p2 at ('C') into (partition p2a, partition p2b);
select tableoid::regclass, * from rp_en_old order by id;
      tableoid      | id | k 
--------------------+----+---
 rp_en_old_1_prt_p1 |  1 | a
(1 row)

alter table rp_c_old_add add partition p1 start ('B') end ('a');
alter table rp_en_old_add add partition p1 start ('a') end ('B');
select tablename, partitionname, partitionrangestart, partitionrangeend
from pg_partitions
where schemaname = 'partition_collation'
  and tablename in ('rp_c_old', 'rp_en_old', 'rp_c_old_add', 'rp_en_old_add')
order by tablename, partitionname;
   tablename   | partitionname |    partitionrangestart    |     partitionrangeend     
---------------+---------------+---------------------------+---------------------------
 rp_c_old      | p1a           | '0'::text COLLATE "C"     | 'C'::text COLLATE "C"
 rp_c_old      | p1b           | 'C'::text COLLATE "C"     | 'b'::text COLLATE "C"
 rp_c_old      | p2            | 'b'::text                 | 'z'::text
 rp_c_old_add  | p1            | 'B'::text COLLATE "C"     | 'a'::text COLLATE "C"
 rp_c_old_add  | p2            | 'a'::text                 | 'z'::text
 rp_en_old     | p1            | '0'::text                 | 'b'::text
 rp_en_old     | p2a           | 'b'::text COLLATE coll_en | 'C'::text COLLATE coll_en
 rp_en_old     | p2b           | 'C'::text COLLATE coll_en | 'z'::text COLLATE coll_en
 rp_en_old_add | p1            | 'a'::text COLLATE coll_en | 'B'::text COLLATE coll_en
 rp_en_old_add | p2            | 'B'::text                 | 'z'::text
(10 rows)

-- Tables created by earlier versions also store their partitions in the order
-- of the database default collation. Partitions must still be found using the
-- key's collation. Store the partitions in the order of the other collation:
-- p1, p2, p3 for the "C" key and p3, p1, p2 for the en_US.utf8 key.
create table rp_c_old_ord (id int, k text collate "C")
distributed by (id)
partition by range (k)
(partition p1 start ('a') end ('c'),
 partition p2 start ('d') end ('e'),
 partition p3 start ('X') end ('Y'));
create table rp_en_old_ord (id int, k text collate coll_en)
distributed by (id)
partition by range (k)
(partition p1 start ('a') end ('c'),
 partition p2 start ('d') end ('e'),
 partition p3 start ('X') end ('Y'));
set allow_system_table_mods = on;
update pg_partition_rule r
set parruleord = 10 + case r.parname when 'p1' then 1 when 'p2' then 2 else 3 end
from pg_partition p
where r.paroid = p.oid and p.parrelid = 'rp_c_old_ord'::regclass;
update pg_partition_rule r
set parruleord = 10 + case r.parname when 'p3' then 1 when 'p1' then 2 else 3 end
from pg_partition p
where r.paroid = p.oid and p.parrelid = 'rp_en_old_ord'::regclass;
update pg_partition_rule r
set parruleord = parruleord - 10
from pg_partition p
where r.paroid = p.oid
  and p.parrelid in ('rp_c_old_ord'::regclass, 'rp_en_old_ord'::regclass);
reset allow_system_table_mods;
select tablename, partitionname, partitionposition
from pg_partitions
where schemaname = 'partition_collation'
  and tablename in ('rp_c_old_ord', 'rp_en_old_ord')
order by tablename, partitionposition;
   tablename   | partitionname | partitionposition 
---------------+---------------+-------------------
 rp_c_old_ord  | p1            |                 1
 rp_c_old_ord  | p2            |                 2
 rp_c_old_ord  | p3            |                 3
 rp_en_old_ord | p3            |                 1
 rp_en_old_ord | p1            |                 2
 rp_en_old_ord | p2            |                 3
(6 rows)

-- 'Xb' is in p3 for both keys, so only row 3 is removed.
insert into rp_c_old_ord values (1, 'b'), (2, 'dd'), (3, 'Xa');
alter table rp_c_old_ord truncate partition for ('Xb');
select tableoid::regclass, * from rp_c_old_ord order by id;
       tableoid        | id | k  
-----------------------+----+----
 rp_c_old_ord_1_prt_p1 |  1 | b
 rp_c_old_ord_1_prt_p2 |  2 | dd
(2 rows)

insert into rp_en_old_ord values (1, 'b'), (2, 'dd'), (3, 'Xa');
alter table rp_en_old_ord truncate partition for ('Xb');
select tableoid::regclass, * from rp_en_old_ord order by id;
        tableoid        | id | k  
------------------------+----+----
 rp_en_old_ord_1_prt_p1 |  1 | b
 rp_en_old_ord_1_prt_p2 |  2 | dd
(2 rows)

drop table rp_c_old, rp_en_old, rp_c_old_add, rp_en_old_add;
drop table rp_c_old_ord, rp_en_old_ord;
drop table rp_def_old, rp_def_old_c_add, rp_def_old_en_add;
drop function copy_bounds(regclass, regclass);
--
-- Partition boundaries carry the collation of the partitioning key.
--
select tablename, partitionname, partitionrangestart, partitionrangeend
from pg_partitions
where schemaname = 'partition_collation' and tablename in ('rp_c', 'rp_en')
  and not partitionisdefault
order by tablename;
 tablename | partitionname |    partitionrangestart    |     partitionrangeend     
-----------+---------------+---------------------------+---------------------------
 rp_c      | p1            | 'a'::text COLLATE "C"     | 'c'::text COLLATE "C"
 rp_en     | p1            | 'a'::text COLLATE coll_en | 'c'::text COLLATE coll_en
(2 rows)

-- Each subpartition level, and the subpartition template, carries the
-- collation of its own key.
select partitionlevel, partitiontablename, partitionrangestart, partitionrangeend
from pg_partitions
where schemaname = 'partition_collation' and tablename = 'rp_sub'
order by partitionlevel, partitiontablename;
 partitionlevel |    partitiontablename    |    partitionrangestart    |     partitionrangeend     
----------------+--------------------------+---------------------------+---------------------------
              0 | rp_sub_1_prt_p1          | '0'::text COLLATE "C"     | 'b'::text COLLATE "C"
              0 | rp_sub_1_prt_p2          | 'b'::text COLLATE "C"     | 'z'::text COLLATE "C"
              1 | rp_sub_1_prt_p1_2_prt_s1 | '0'::text COLLATE coll_en | 'b'::text COLLATE coll_en
              1 | rp_sub_1_prt_p1_2_prt_s2 | 'b'::text COLLATE coll_en | 'z'::text COLLATE coll_en
              1 | rp_sub_1_prt_p2_2_prt_s1 | '0'::text COLLATE coll_en | 'b'::text COLLATE coll_en
              1 | rp_sub_1_prt_p2_2_prt_s2 | 'b'::text COLLATE coll_en | 'z'::text COLLATE coll_en
(6 rows)

select partitionlevel, partitionname, partitionrangestart, partitionrangeend
from pg_partition_templates
where schemaname = 'partition_collation' and tablename = 'rp_sub'
order by partitionname;
 partitionlevel | partitionname |    partitionrangestart    |     partitionrangeend     
----------------+---------------+---------------------------+---------------------------
              1 | s1            | '0'::text COLLATE coll_en | 'b'::text COLLATE coll_en
              1 | s2            | 'b'::text COLLATE coll_en | 'z'::text COLLATE coll_en
(2 rows)

-- LIST values carry the collation of the partitioning key too, including
-- values added by ADD PARTITION and SPLIT PARTITION.
create table lp_c (id int, k text collate "C")
distributed by (id)
partition by list (k)
(partition p1 values ('a', 'b'),
 partition p2 values ('c', 'd'));
alter table lp_c add partition p3 values ('e');
alter table lp_c split partition p2 at ('c') into (partition p2a, partition p2b);
create table lp_en (id int, k text collate coll_en)
distributed by (id)
partition by list (k)
(partition p1 values ('a', 'b'),
 partition p2 values ('c', 'd'));
alter table lp_en add partition p3 values ('e');
alter table lp_en split partition p2 at ('c') into (partition p2a, partition p2b);
select tablename, partitionname, partitionlistvalues
from pg_partitions
where schemaname = 'partition_collation' and tablename in ('lp_c', 'lp_en')
order by tablename, partitionname;
 tablename | partitionname |                 partitionlistvalues                  
-----------+---------------+------------------------------------------------------
 lp_c      | p1            | 'a'::text COLLATE "C", 'b'::text COLLATE "C"
 lp_c      | p2a           | 'd'::text COLLATE "C"
 lp_c      | p2b           | 'c'::text COLLATE "C"
 lp_c      | p3            | 'e'::text COLLATE "C"
 lp_en     | p1            | 'a'::text COLLATE coll_en, 'b'::text COLLATE coll_en
 lp_en     | p2a           | 'd'::text COLLATE coll_en
 lp_en     | p2b           | 'c'::text COLLATE coll_en
 lp_en     | p3            | 'e'::text COLLATE coll_en
(8 rows)

--
-- The partition definition is printed in the CREATE TABLE syntax, which has
-- no COLLATE clause for boundaries, and pg_dump relies on it. Check the
-- output, then create a copy of each table from it and insert the same rows.
--
select pg_get_partition_def('rp_c'::regclass, true);
                    pg_get_partition_def                    
------------------------------------------------------------
 PARTITION BY RANGE(k)                                     +
           (                                               +
           PARTITION p1 START ('a'::text) END ('c'::text), +
           DEFAULT PARTITION other                         +
           )
(1 row)

select pg_get_partition_def('rp_en'::regclass, true);
                    pg_get_partition_def                    
------------------------------------------------------------
 PARTITION BY RANGE(k)                                     +
           (                                               +
           PARTITION p1 START ('a'::text) END ('c'::text), +
           DEFAULT PARTITION other                         +
           )
(1 row)

select pg_get_partition_def('rp_sub'::regclass, true);
                         pg_get_partition_def                          
-----------------------------------------------------------------------
 PARTITION BY RANGE(k1)                                               +
           SUBPARTITION BY RANGE(k2)                                  +
           (                                                          +
           PARTITION p1 START ('0'::text) END ('b'::text)             +
                   (                                                  +
                   SUBPARTITION s1 START ('0'::text) END ('b'::text), +
                   SUBPARTITION s2 START ('b'::text) END ('z'::text)  +
                   ),                                                 +
           PARTITION p2 START ('b'::text) END ('z'::text)             +
                   (                                                  +
                   SUBPARTITION s1 START ('0'::text) END ('b'::text), +
                   SUBPARTITION s2 START ('b'::text) END ('z'::text)  +
                   )                                                  +
           )
(1 row)

select pg_get_partition_template_def('rp_sub'::regclass, true, false);
                 pg_get_partition_template_def                 
---------------------------------------------------------------
 ALTER TABLE rp_sub                                           +
 SET SUBPARTITION TEMPLATE                                    +
           (                                                  +
           SUBPARTITION s1 START ('0'::text) END ('b'::text), +
           SUBPARTITION s2 START ('b'::text) END ('z'::text)  +
           )                                                  +
 
(1 row)

select pg_get_partition_def('lp_c'::regclass, true);
           pg_get_partition_def            
-------------------------------------------
 PARTITION BY LIST(k)                     +
           (                              +
           PARTITION p1 VALUES('a', 'b'), +
           PARTITION p2a VALUES('d'),     +
           PARTITION p3 VALUES('e'),      +
           PARTITION p2b VALUES('c')      +
           )
(1 row)

select pg_get_partition_def('lp_en'::regclass, true);
           pg_get_partition_def            
-------------------------------------------
 PARTITION BY LIST(k)                     +
           (                              +
           PARTITION p1 VALUES('a', 'b'), +
           PARTITION p2a VALUES('d'),     +
           PARTITION p3 VALUES('e'),      +
           PARTITION p2b VALUES('c')      +
           )
(1 row)

do $$
begin
	execute 'create table rp_c_copy (id int, k text collate "C") distributed by (id) '
		|| pg_get_partition_def('rp_c'::regclass);
	execute 'create table rp_en_copy (id int, k text collate coll_en) distributed by (id) '
		|| pg_get_partition_def('rp_en'::regclass);
	execute 'create table rp_sub_copy (id int, k1 text collate "C", k2 text collate coll_en) distributed by (id) '
		|| pg_get_partition_def('rp_sub'::regclass);
end
$$;
insert into rp_c_copy values (1, 'B'), (2, 'a'), (3, 'b'), (4, 'd');
select tableoid::regclass, * from rp_c_copy order by id;
       tableoid        | id | k 
-----------------------+----+---
 rp_c_copy_1_prt_other |  1 | B
 rp_c_copy_1_prt_p1    |  2 | a
 rp_c_copy_1_prt_p1    |  3 | b
 rp_c_copy_1_prt_other |  4 | d
(4 rows)

insert into rp_en_copy values (1, 'B'), (2, 'a'), (3, 'b'), (4, 'd');
select tableoid::regclass, * from rp_en_copy order by id;
        tableoid        | id | k 
------------------------+----+---
 rp_en_copy_1_prt_p1    |  1 | B
 rp_en_copy_1_prt_p1    |  2 | a
 rp_en_copy_1_prt_p1    |  3 | b
 rp_en_copy_1_prt_other |  4 | d
(4 rows)

insert into rp_sub_copy values (1, 'C', 'C'), (2, 'x', 'a');
select tableoid::regclass, * from rp_sub_copy order by id;
           tableoid            | id | k1 | k2 
-------------------------------+----+----+----
 rp_sub_copy_1_prt_p1_2_prt_s2 |  1 | C  | C
 rp_sub_copy_1_prt_p2_2_prt_s1 |  2 | x  | a
(2 rows)

reset search_path;
drop schema partition_collation cascade;
reset client_min_messages;
