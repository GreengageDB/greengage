FROM (SELECT ow_sale_ord.* FROM ow_sale_ord,ow_product,ow_vendor,ow_customer WHERE ow_sale_ord.pn=ow_product.pn AND ow_sale_ord.vn=ow_vendor.vn AND ow_sale_ord.cn=ow_customer.cn) ow_sale
WINDOW win1 as (order by ow_sale.cn asc,ow_sale.pn desc,ow_sale.cn asc); -- mvd 4,1->6; 
 pn  | vn | pn  | cn | cn |      to_char      
-----+----+-----+----+----+-------------------
 500 | 30 | 500 |  1 |  1 |        12.0000000
 400 | 50 | 400 |  1 |  1 |        12.0000000
 300 | 30 | 300 |  1 |  1 |        12.0000000
 200 | 10 | 200 |  1 |  1 |        12.0000000
 100 | 20 | 100 |  1 |  1 |        12.0000000
 400 | 50 | 400 |  2 |  2 |        12.0000000
 100 | 40 | 100 |  2 |  2 |      1100.0000000
 600 | 30 | 600 |  3 |  3 |      1100.0000000
 500 | 30 | 500 |  3 |  3 |      1100.0000000
 200 | 40 | 200 |  3 |  3 |      1100.0000000
 800 | 40 | 800 |  4 |  4 |      1100.0000000
 700 | 40 | 700 |  4 |  4 |      1100.0000000
(12 rows)

