WINDOW win1 as (partition by ow_sale.vn,ow_sale.prc,ow_sale.qty,ow_sale.pn order by ow_sale.cn asc,ow_sale.cn desc,ow_sale.cn asc); -- mvd 6,7,2,3,1->5; 
