# .coveragerc to control coverage.py
[run]
parallel = True
context = ${FEATURE}
data_file = /tmp/coverage-data/$PROJECT-coverage-data/coverage-data
branch = True
omit =
        */__init__.py*
        */sitecustomize.py*
        */test/*
        */gpload_test/*
        $GPHOME/lib/python/pygresql/*
        $GPHOME/lib/python/yaml/*
        $GPHOME/lib/python/pg.py
        $GPHOME/lib/python/pgdb.py
        $GPHOME/lib/python/sitecustomize.py
        $GPHOME/lib/python/subprocess32.py
        $GPHOME/lib/python/subprocess32.pyc
        $GPHOME/bin/lib/pexpect/*
        $GPHOME/lib/python/psutil/*
        */dist-packages/*
        /usr/local/bin/behave
        /usr/local/bin/coverage
        /tmp/*

[paths]
source =
        /home/gpadmin/gpdb_src/gpMgmt/bin
        /home/gpadmin/gpdb_src/gpMgmt/bin
        $GPHOME/bin

source2 =
        /home/gpadmin/gpdb_src/gpMgmt/sbin
        /home/gpadmin/gpdb_src/gpMgmt/sbin
        $GPHOME/sbin

source3 =
        /home/gpadmin/gpdb_src/gpMgmt/bin/gppylib
        /home/gpadmin/gpdb_src/gpMgmt/bin/gppylib
        $GPHOME/lib/python/gppylib

source4 =
        /home/gpadmin/gpdb_src/gpAux/gpperfmon/src/gpmon
        /home/gpadmin/gpdb_src/gpAux/gpperfmon/src/gpmon
        $GPHOME/bin
        $GPHOME/sbin
