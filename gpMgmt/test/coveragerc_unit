# .coveragerc to control coverage.py
[run]
parallel = True
dynamic_context = test_function
data_file = /tmp/coverage-data/coverage-data
branch = True
omit =
        */__init__.py*
        */sitecustomize.py*
        */test/*
        */gpload_test/*
        /usr/local/greengage-db-devel/lib/python/pygresql/*
        /usr/local/greengage-db-devel/lib/python/yaml/*
        /usr/local/greengage-db-devel/lib/python/sitecustomize.py
        /usr/local/greengage-db-devel/lib/python/subprocess32.py
        /usr/local/greengage-db-devel/lib/python/subprocess32.pyc
        /usr/local/greengage-db-devel/bin/lib/pexpect/*
        /usr/local/greengage-db-devel/lib/python/psutil/*
        */dist-packages/*
        /usr/local/bin/behave
        /usr/local/bin/coverage
        /tmp/*

[paths]
source =
        /home/gpadmin/gpdb_src/gpMgmt/bin
        /home/gpadmin/gpdb_src/gpMgmt/bin
        /usr/local/greengage-db-devel/bin

source2 =
        /home/gpadmin/gpdb_src/gpMgmt/sbin
        /home/gpadmin/gpdb_src/gpMgmt/sbin
        /usr/local/greengage-db-devel/sbin

source3 =
        /home/gpadmin/gpdb_src/gpMgmt/bin/gppylib
        /home/gpadmin/gpdb_src/gpMgmt/bin/gppylib
        /usr/local/greengage-db-devel/lib/python/gppylib

source4 =
        /home/gpadmin/gpdb_src/gpcontrib/gp_replica_check/gp_replica_check.py
        /home/gpadmin/gpdb_src/gpcontrib/gp_replica_check/gp_replica_check.py
        /usr/local/greengage-db-devel/bin/gp_replica_check.py
