# .coveragerc to control coverage.py
[run]
parallel = True
# context = behave_tests
# dynamic_context = test_function
data_file = /tmp/coverage-data/coverage-data
branch = True
omit =
        /usr/local/greengage-db-devel/bin/gpssh
        /usr/local/greengage-db-devel/bin/gpssh_modules/__init__.py
        /usr/local/greengage-db-devel/bin/gpssh_modules/gppxssh_wrapper.py
        /usr/local/greengage-db-devel/bin/lib/pexpect/__init__.py
        /usr/local/greengage-db-devel/bin/lib/pexpect/pxssh.py
        */dist-packages/*
        /usr/local/bin/behave