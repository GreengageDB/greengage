# ci/tpcds/.env — defaults for the TPC-DS benchmark environment.
# Override any of these on the command line, e.g.:
#   GREENGAGE_IMAGE=greengage8_u22:adb-8.x LABEL=adb-8.x SCALE=10 ./run.sh

# Base Greengage image under test (built from ci/Dockerfile.ubuntu on the branch
# you want to benchmark). This is the *only* thing that changes between versions.
GREENGAGE_IMAGE=greengage8_u22:claude-merge-7

# Human-readable label for this run's results file (results/tpcds_<LABEL>.md).
# Defaults in run.sh to the image tag if unset.
LABEL=claude-merge-7

# TPC-DS scale factor in GB (harness default is 3000 = 3TB — far too big here).
SCALE=1

# Demo-cluster shape inside the single container.
NUM_PRIMARY_MIRROR_PAIRS=3
WITH_MIRRORS=false

# Benchmark stages / knobs passed to the harness (rollout.sh positional args).
EXPLAIN_ANALYZE=false
RANDOM_DISTRIBUTION=false
MULTI_USER_COUNT=3
SINGLE_USER_ITERATIONS=1
# Set RUN_MULTI_USER=false for a faster single-user-only smoke run (the TPC-DS
# "Score" needs the multi-user phase, so leave true for a complete score).
RUN_MULTI_USER=true

COMPOSE_HTTP_TIMEOUT=400
