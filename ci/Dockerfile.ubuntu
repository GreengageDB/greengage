ARG OS_VERSION=22.04

FROM ubuntu:${OS_VERSION} AS base
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /home/gpadmin

ARG CONFIGURE_FLAGS="--enable-debug-extensions --with-gssapi --enable-cassert --enable-debug --enable-depend" \
    SKIP_UNITTESTS=

ENV PIP_BREAK_SYSTEM_PACKAGES=1

COPY README.Ubuntu.bash ./

RUN set -eux; \
    ./README.Ubuntu.bash; \
    rm -rf /var/lib/apt/lists/*; \
    rm README.Ubuntu.bash; \
# The en_US.UTF-8 locale is needed to run GPDB
    locale-gen en_US.UTF-8; \
# To run sshd directly, but not using `/etc/init.d/ssh start`
    mkdir /run/sshd; \
# Alter precedence in favor of IPv4 during resolving
    echo 'precedence ::ffff:0:0/96  100' >> /etc/gai.conf; \
# Install Python packages
    pip3 install --no-cache-dir --prefer-binary --ignore-installed \
      allure-behave==2.4.0 \
      behave~=1.2.6 \
      coverage~=4.5 \
      gsutil \
      'mock<=5.0.0' \
      protobuf==3.20.0 \
      pytest

ENV LANG=en_US.UTF-8 \
    TARGET_OS=ubuntu \
    CONFIGURE_FLAGS=$CONFIGURE_FLAGS \
    OUTPUT_ARTIFACT_DIR=bin_gpdb \
    SKIP_UNITTESTS=$SKIP_UNITTESTS

FROM base AS build

COPY . gpdb_src

# Compile with running mocking tests unless SKIP_UNITTESTS is set
RUN gpdb_src/concourse/scripts/compile_gpdb.bash

FROM base AS code
COPY . gpdb_src
RUN rm -rf gpdb_src/.git/

FROM base AS test
COPY --from=code /home/gpadmin/gpdb_src gpdb_src
COPY --from=build /home/gpadmin/$OUTPUT_ARTIFACT_DIR $OUTPUT_ARTIFACT_DIR
COPY --from=build /home/gpadmin/gpdb_src/VERSION gpdb_src
